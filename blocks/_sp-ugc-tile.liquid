{% doc %}
  One customer photo tile beside the quote.

  @example
  @someone's dog
{% enddoc %}

{%- liquid
  assign b = block.settings
-%}

<figure class="sp-quote__tile" {{ block.shopify_attributes }}>
  {%- if b.image != blank -%}
    <img src="{{ b.image | image_url: width: 600 }}" alt="{{ b.image.alt | escape }}" width="{{ b.image.width }}" height="{{ b.image.height }}" loading="lazy">
  {%- else -%}
    <span class="sp-quote__ph">{{ b.handle | default: '[ customer photo ]' | escape }}</span>
  {%- endif -%}
  {%- if b.handle != blank -%}<figcaption>{{ b.handle | escape }}</figcaption>{%- endif -%}
</figure>

{% stylesheet %}
  .sp-quote__tile { position: relative; margin: 0; aspect-ratio: 1 / 1; border-radius: var(--sp-r-tile, 22px); overflow: hidden; background: var(--sp-mint, #e7f0e2); display: grid; place-items: center; }
  .sp-quote__tile img { width: 100%; height: 100%; object-fit: cover; }
  .sp-quote__ph { padding: 8px; font-size: 11px; font-weight: 700; color: #4c5b50; text-align: center; }
  .sp-quote__tile figcaption { position: absolute; left: 8px; bottom: 8px; padding: 4px 10px; border-radius: 999px; background: rgb(251 247 239 / 0.92); font-size: 11px; font-weight: 700; }
{% endstylesheet %}

{% schema %}
{
  "name": "Customer photo",
  "tag": null,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "handle", "label": "Handle", "default": "@sproutpets" }
  ],
  "presets": [{ "name": "Customer photo", "category": "t:categories.custom" }]
}
{% endschema %}
