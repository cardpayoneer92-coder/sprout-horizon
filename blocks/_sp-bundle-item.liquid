{% doc %}
  One piece in the bundle builder. Tap it to add or drop it from the set.

  @example
  Cloud bed · [PRICE]
{% enddoc %}

{%- liquid
  assign b = block.settings
  assign p = b.product
  assign v = p.selected_or_first_available_variant
  comment
    No product picked: shoppers never see the tile (it could not be added);
    the merchant still does, in the editor. Sold out: shown, but cannot be
    picked, so the set never fails at the bag.
  endcomment
  assign usable = false
  if p != blank and v.available
    assign usable = true
  endif
-%}

{%- if p != blank or request.design_mode -%}
<button
  type="button"
  class="sp-bundle__item{% if b.selected and usable %} is-on{% endif %}{% unless usable %} is-off{% endunless %}"
  data-bundle-item
  {%- if usable %} data-variant="{{ v.id }}"{% else %} disabled{% endif %}
  aria-pressed="{% if b.selected and usable %}true{% else %}false{% endif %}"
  {{ block.shopify_attributes }}
>
  <span class="sp-bundle__tick" aria-hidden="true">{% render 'sp-icon', name: 'check', size: 15 %}</span>
  <span class="sp-bundle__media">
    {%- comment -%} The merchant's override wins over the product photo. {%- endcomment -%}
    {%- if b.image != blank -%}
      {{ b.image | image_url: width: 600 | image_tag: alt: '', widths: '200, 300, 400, 600', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy' }}
    {%- elsif p != blank and p.featured_media -%}
      {{ p.featured_media | image_url: width: 600 | image_tag: alt: '', widths: '200, 300, 400, 600', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy' }}
    {%- else -%}
      <span class="sp-bundle__art sp-bob">{% render 'sp-art', name: b.art, size: 110 %}</span>
      {%- if p != blank -%}
        {%- assign shot = 'sp-' | append: p.handle | append: '-1.png' -%}
        <img class="sp-bundle__shot" data-sp-fallback src="{{ shot | asset_url }}" alt="" loading="lazy">
      {%- endif -%}
    {%- endif -%}
  </span>
  <span class="sp-bundle__name">{% if b.title != blank %}{{ b.title | escape }}{% elsif p != blank %}{{ p.title }}{% endif %}</span>
  <span class="sp-bundle__price">
    {%- if p == blank -%}{{ 'Pick a product' }}
    {%- elsif usable -%}{{ v.price | money }}
    {%- else -%}{{ settings.sp_t_sold_out | escape }}{%- endif -%}
  </span>
</button>
{%- endif -%}

{% stylesheet %}
  .sp-bundle__item { position: relative; display: flex; flex-direction: column; align-items: center; gap: 9px; padding: 14px; border: 2px solid var(--sp-line, #e3dccd); border-radius: var(--sp-r-card, 28px); background: var(--sp-cream, #fbf7ef); color: inherit; font-family: inherit; cursor: pointer; transition: transform 0.3s var(--sp-ease), border-color 0.2s ease, box-shadow 0.2s ease; }
  .sp-bundle__item:hover { transform: translateY(-4px); }
  .sp-bundle__item.is-off { cursor: not-allowed; opacity: 0.6; }
  .sp-bundle__item.is-off:hover { transform: none; }
  .sp-bundle__item.is-on { border-color: var(--sp-moss, #3f6b4a); box-shadow: 0 0 0 4px var(--sp-mint, #e7f0e2); }
  .sp-bundle__tick { position: absolute; top: 10px; right: 10px; z-index: 2; display: grid; place-items: center; width: 26px; height: 26px; border-radius: 999px; background: #ece6d9; color: #ece6d9; transition: background-color 0.2s ease, color 0.2s ease; }
  .sp-bundle__item.is-on .sp-bundle__tick { background: var(--sp-moss, #3f6b4a); color: var(--sp-cream, #fbf7ef); }
  .sp-bundle__shot { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .sp-bundle__media { position: relative; width: 100%; aspect-ratio: 1 / 1; border-radius: var(--sp-r-tile, 22px); overflow: hidden; background: var(--sp-mint, #e7f0e2); display: grid; place-items: center; }
  .sp-bundle__media img { width: 100%; height: 100%; object-fit: cover; }
  .sp-bundle__art { display: grid; place-items: center; }
  .sp-bundle__art .sp-art { width: 66%; max-width: none; height: auto; }
  .sp-bundle__item:nth-child(2n) .sp-bundle__media { background: var(--sp-peach); }
  .sp-bundle__item:nth-child(3n) .sp-bundle__media { background: var(--sp-sun); }
  .sp-bundle__item:nth-child(4n) .sp-bundle__media { background: var(--sp-sky); }
  .sp-bundle__name { font-weight: 700; font-size: 15px; text-align: center; }
  .sp-bundle__price { font-size: 13px; color: var(--sp-muted, #5e6e60); }
  @media (prefers-reduced-motion: reduce) { .sp-bundle__item { transition: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Bundle item",
  "tag": null,
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "title", "label": "Title override" },
    { "type": "image_picker", "id": "image", "label": "Image override", "info": "Shown instead of the product photo." },
    { "type": "checkbox", "id": "selected", "label": "Selected to start", "default": false },
    {
      "type": "select", "id": "art", "label": "Illustration", "default": "bed",
      "info": "Shown when the product has no photo.",
      "options": [
        { "value": "bed", "label": "Bed" }, { "value": "blanket", "label": "Blanket" }, { "value": "bone", "label": "Rope bone" }, { "value": "bowl", "label": "Bowl" }, { "value": "bunny", "label": "Bunny" }, { "value": "cat", "label": "Cat" }, { "value": "dog", "label": "Dog" }, { "value": "duo", "label": "Dog and cat" }, { "value": "jar", "label": "Treat jar" }, { "value": "pouch", "label": "Food pouch" }, { "value": "puppy", "label": "Puppy" }, { "value": "tin", "label": "Tin" }
      ]
    }
  ],
  "presets": [{ "name": "Bundle item", "category": "t:categories.custom" }]
}
{% endschema %}
