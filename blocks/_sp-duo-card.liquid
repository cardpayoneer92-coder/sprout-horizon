{% doc %}
  One of the big colour cards above the footer: a heading, a paragraph, a
  button and a large watermark illustration drifting in the corner.

  @example
  Never run out — subscribe and save 10% on every delivery
{% enddoc %}

{%- liquid
  assign b = block.settings
-%}

<div
  class="sp-duo__card sp-reveal{% if b.image != blank %} sp-duo__card--photo{% endif %}"
  style="--sp-duo-bg: {{ b.background }}; --sp-duo-fg: {{ b.text_color }}; --sp-duo-btn: {{ b.button_background }}; --sp-duo-btn-fg: {{ b.button_text_color }};"
  {{ block.shopify_attributes }}
>
  {%- if b.image != blank -%}
    <div class="sp-duo__photo">
      <img
        src="{{ b.image | image_url: width: 900 }}"
        srcset="{{ b.image | image_url: width: 500 }} 500w, {{ b.image | image_url: width: 900 }} 900w, {{ b.image | image_url: width: 1300 }} 1300w"
        sizes="(min-width: 990px) 25vw, 90vw"
        alt="{{ b.image.alt | escape }}"
        width="{{ b.image.width }}"
        height="{{ b.image.height }}"
        loading="lazy"
        style="object-position: {{ b.focal_x }}% {{ b.focal_y }}%;"
      >
    </div>
  {%- else -%}
    <span class="sp-duo__art sp-bob sp-duo__art--{{ b.art_position }}" aria-hidden="true">
      {% render 'sp-art', name: b.art, size: 200 %}
    </span>
  {%- endif -%}

  <div class="sp-duo__body">
    {%- if b.eyebrow != blank -%}<p class="sp-duo__eyebrow">{{ b.eyebrow | escape }}</p>{%- endif -%}
    {%- if b.heading != blank -%}<h3 class="sp-duo__title">{{ b.heading | escape }}</h3>{%- endif -%}
    {%- if b.text != blank -%}<p class="sp-duo__text">{{ b.text | escape }}</p>{%- endif -%}
    {%- if b.button_text != blank -%}
      <a class="sp-btn sp-duo__btn" href="{{ b.button_link | default: '#' }}">{{ b.button_text | escape }}</a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .sp-duo__card {
    position: relative; overflow: hidden;
    border-radius: var(--sp-r-band, 36px);
    background: var(--sp-duo-bg, #2f7a46); color: var(--sp-duo-fg, #fdfaf2);
    padding: clamp(30px, 3.4vw, 44px) clamp(26px, 3vw, 38px);
    display: flex; align-items: center; min-height: 260px;
  }
  .sp-duo__body { position: relative; z-index: 1; max-width: 42ch; }

  .sp-duo__art { position: absolute; z-index: 0; opacity: 0.22; pointer-events: none; }
  .sp-duo__art .sp-art { width: 190px; height: auto; max-width: none; }
  .sp-duo__art--bottom-right { right: -22px; bottom: -26px; }
  .sp-duo__art--top-right { right: 14px; top: 14px; }
  .sp-duo__art--bottom-left { left: -22px; bottom: -26px; }

  .sp-duo__card--photo { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(18px, 2.4vw, 30px); align-items: stretch; }
  .sp-duo__card--photo .sp-duo__body { align-self: center; order: 0; }
  .sp-duo__photo { order: 1; position: relative; min-height: 220px; border-radius: calc(var(--sp-r-band, 36px) - 12px); overflow: hidden; box-shadow: 0 14px 32px rgb(39 55 43 / 0.16); }
  .sp-duo__photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s var(--sp-ease); }
  .sp-duo__card--photo:hover .sp-duo__photo img { transform: scale(1.04); }

  .sp-duo__eyebrow { margin: 0 0 8px; font-size: 13px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.78; }
  .sp-duo__title { margin: 0 0 12px; font-family: var(--sp-font-head); font-size: clamp(26px, 2.6vw, 36px); font-weight: 500; letter-spacing: -0.015em; line-height: 1.1; }
  .sp-duo__text { margin: 0 0 22px; font-size: 17px; line-height: 1.55; opacity: 0.9; }
  .sp-duo__btn { background: var(--sp-duo-btn, #ffd54a); color: var(--sp-duo-btn-fg, #27372b); }

  @media (max-width: 749px) {
    .sp-duo__card { min-height: 0; }
    .sp-duo__art .sp-art { width: 140px; }
    .sp-duo__card--photo { grid-template-columns: minmax(0, 1fr); }
    .sp-duo__card--photo .sp-duo__photo { order: -1; aspect-ratio: 4 / 3; min-height: 0; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Big card",
  "tag": null,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Never run out" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Subscribe and save 10% on every delivery. We nudge you a few days before the next one — skip, swap or cancel any time." },
    { "type": "text", "id": "button_text", "label": "Button", "default": "Set up a delivery" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Photo" },
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Sits beside the text. Leave empty to use the illustration." },
    { "type": "range", "id": "focal_x", "label": "Focus across", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "focal_y", "label": "Focus down", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "header", "content": "Illustration" },
    {
      "type": "select", "id": "art", "label": "Illustration", "default": "pouch",
      "options": [
        { "value": "pouch", "label": "Pouch" },
        { "value": "tin", "label": "Tin" },
        { "value": "jar", "label": "Jar" },
        { "value": "bowl", "label": "Bowl" },
        { "value": "bed", "label": "Bed" },
        { "value": "bone", "label": "Bone" },
        { "value": "blanket", "label": "Blanket" },
        { "value": "duo", "label": "Dog and cat" }
      ]
    },
    {
      "type": "select", "id": "art_position", "label": "Illustration corner", "default": "bottom-right",
      "options": [
        { "value": "bottom-right", "label": "Bottom right" },
        { "value": "top-right", "label": "Top right" },
        { "value": "bottom-left", "label": "Bottom left" }
      ]
    },
    { "type": "header", "content": "Colour" },
    { "type": "color", "id": "background", "label": "Background", "default": "#2f7a46" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#fdfaf2" },
    { "type": "color", "id": "button_background", "label": "Button", "default": "#ffd54a" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#27372b" }
  ],
  "presets": [{ "name": "Big card", "category": "t:categories.custom" }]
}
{% endschema %}
