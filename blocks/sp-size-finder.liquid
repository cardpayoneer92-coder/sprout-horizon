{% doc %}
  Size finder for the product page: the shopper puts in a weight and the
  block names the pack size, the daily portion and how long a pack lasts.
  It seeds itself from the saved pet profile and writes back to it.

  @example
  14 kg → Medium pack, about 310g a day
{% enddoc %}

{%- liquid
  assign b = block.settings
-%}

<sp-size-finder
  class="sp-finder"
  data-small-max="{{ b.small_max }}"
  data-medium-max="{{ b.medium_max }}"
  data-grams-per-kg="{{ b.grams_per_kg }}"
  data-pack-small="{{ b.pack_small }}"
  data-pack-medium="{{ b.pack_medium }}"
  data-pack-large="{{ b.pack_large }}"
  {{ block.shopify_attributes }}
>
  {%- if b.heading != blank -%}<h2 class="sp-finder__title">{{ b.heading | escape }}</h2>{%- endif -%}
  {%- if b.text != blank -%}<p class="sp-finder__text">{{ b.text | escape }}</p>{%- endif -%}

  <div class="sp-finder__row">
    <label class="sp-finder__field">
      <span>{{ b.weight_label | escape }}</span>
      <input type="number" min="1" max="90" value="{{ b.weight_default }}" data-weight inputmode="numeric">
    </label>
    <label class="sp-finder__field">
      <span>{{ b.chest_label | escape }}</span>
      <input type="number" min="10" max="140" placeholder="{{ b.chest_placeholder | escape }}" data-chest inputmode="numeric">
    </label>
  </div>

  <p class="sp-finder__out" aria-live="polite">
    <strong data-size-out></strong><br>
    <span data-note-out></span>
  </p>
</sp-size-finder>

<script type="module">
  if (!customElements.get('sp-size-finder')) {
    customElements.define('sp-size-finder', class extends HTMLElement {
      connectedCallback() {
        this.input = this.querySelector('[data-weight]');
        const saved = this.read();
        if (saved && saved.weight && this.input) this.input.value = saved.weight;
        if (this.input) this.input.addEventListener('input', () => { this.paint(); this.save(); });
        this.paint();
      }
      read() {
        try { return JSON.parse(localStorage.getItem('sprout:pet')) || null; } catch (e) { return null; }
      }
      save() {
        const kg = Number(this.input && this.input.value);
        if (!Number.isFinite(kg) || kg < 1) return;
        const prev = this.read() || {};
        const next = Object.assign({}, prev, { weight: kg, pet: prev.pet || 'Dog' });
        try { localStorage.setItem('sprout:pet', JSON.stringify(next)); } catch (e) { /* private window */ }
        document.dispatchEvent(new CustomEvent('sprout:pet-change', { detail: next }));
      }
      num(attr, fallback) {
        const v = Number(this.dataset[attr]);
        return Number.isFinite(v) && v > 0 ? v : fallback;
      }
      paint() {
        const kg = Number(this.input && this.input.value);
        const sizeOut = this.querySelector('[data-size-out]');
        const noteOut = this.querySelector('[data-note-out]');
        if (!Number.isFinite(kg) || kg < 1) {
          if (sizeOut) sizeOut.textContent = 'Put a weight in above';
          if (noteOut) noteOut.textContent = 'We will name the pack size and a rough portion.';
          return;
        }
        const size = kg < this.num('smallMax', 10) ? 'Small' : (kg <= this.num('mediumMax', 25) ? 'Medium' : 'Large');
        const grams = Math.max(10, Math.round((kg * this.num('gramsPerKg', 22)) / 10) * 10);
        const packs = { Small: this.num('packSmall', 1200), Medium: this.num('packMedium', 2400), Large: this.num('packLarge', 4000) };
        const days = Math.max(1, Math.round(packs[size] / grams));
        if (sizeOut) sizeOut.textContent = 'We would go with the ' + size + ' pack';
        if (noteOut) noteOut.textContent = 'About ' + grams + 'g a day — one pack lasts around ' + days + (days === 1 ? ' day.' : ' days.');
      }
    });
  }
</script>

{% stylesheet %}
  .sp-finder { display: block; padding: 22px 24px; border-radius: var(--sp-r-card, 28px); background: var(--sp-mint, #e7f0e2); }
  .sp-finder__title { margin: 0 0 4px; font-family: var(--sp-font-head); font-size: 22px; font-weight: 500; }
  .sp-finder__text { margin: 0 0 16px; font-size: 14px; color: var(--sp-muted, #566358); }
  .sp-finder__row { display: flex; flex-wrap: wrap; gap: 10px; }
  .sp-finder__field { flex: 1 1 140px; min-width: 0; }
  .sp-finder__field span { display: block; margin-bottom: 6px; font-size: 13px; font-weight: 700; }
  .sp-finder__field input { width: 100%; min-height: 48px; padding: 0 16px; border: 2px solid #c9dac2; border-radius: 999px; background: var(--sp-cream, #fbf7ef); font-family: inherit; font-size: 16px; color: inherit; box-sizing: border-box; }
  .sp-finder__out { margin: 16px 0 0; padding: 14px 18px; border-radius: var(--sp-r-tile, 22px); background: var(--sp-cream, #fbf7ef); font-size: 15px; }
  .sp-finder__out span { color: var(--sp-muted, #566358); }
{% endstylesheet %}

{% schema %}
{
  "name": "Size finder",
  "tag": null,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Which size does my pet need?" },
    { "type": "text", "id": "text", "label": "Text", "default": "Pop in their weight and we will work out the portion." },
    { "type": "text", "id": "weight_label", "label": "Weight label", "default": "Weight (kg)" },
    { "type": "text", "id": "chest_label", "label": "Chest label", "default": "Chest (cm, optional)" },
    { "type": "text", "id": "chest_placeholder", "label": "Chest placeholder", "default": "e.g. 54" },
    { "type": "range", "id": "weight_default", "label": "Starting weight", "min": 1, "max": 60, "step": 1, "unit": "kg", "default": 14 },
    { "type": "header", "content": "Sizing rules" },
    { "type": "range", "id": "small_max", "label": "Small is under", "min": 4, "max": 20, "step": 1, "unit": "kg", "default": 10 },
    { "type": "range", "id": "medium_max", "label": "Medium is up to", "min": 12, "max": 45, "step": 1, "unit": "kg", "default": 25 },
    { "type": "range", "id": "grams_per_kg", "label": "Food per kilo", "min": 10, "max": 40, "step": 1, "unit": "g", "default": 22 },
    { "type": "range", "id": "pack_small", "label": "Small pack", "min": 400, "max": 3000, "step": 100, "unit": "g", "default": 1200 },
    { "type": "range", "id": "pack_medium", "label": "Medium pack", "min": 800, "max": 5000, "step": 100, "unit": "g", "default": 2400 },
    { "type": "range", "id": "pack_large", "label": "Large pack", "min": 1500, "max": 8000, "step": 100, "unit": "g", "default": 4000 }
  ],
  "presets": [{ "name": "Size finder", "category": "t:categories.custom" }]
}
{% endschema %}
