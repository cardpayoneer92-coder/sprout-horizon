{% doc %}
  Size finder for the product page: the shopper puts in a weight and the
  block names the pack size, the daily portion and how long a pack lasts.
  It seeds itself from the saved pet profile and writes back to it.

  @example
  14 kg → Medium pack, about 310g a day
{% enddoc %}

{%- liquid
  assign b = block.settings
-%}

{%- comment -%} One implementation, shared with the product and size pages. {%- endcomment -%}
{% render 'sp-finder-card',
  heading: b.heading,
  text: b.text,
  weight_label: b.weight_label,
  weight_default: b.weight_default,
  small_max: b.small_max,
  medium_max: b.medium_max,
  grams_per_kg: b.grams_per_kg,
  pack_small: b.pack_small,
  pack_medium: b.pack_medium,
  pack_large: b.pack_large,
  size_text: b.size_text,
  note_text: b.note_text,
  empty_text: b.empty_text,
  hide_chips: true,
  attrs: block.shopify_attributes
%}

{% schema %}
{
  "name": "Size finder",
  "tag": null,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Which size does my pet need?" },
    { "type": "text", "id": "text", "label": "Text", "default": "Pop in their weight and we will work out the portion." },
    { "type": "text", "id": "weight_label", "label": "Weight label", "default": "Weight (kg)" },
    { "type": "text", "id": "size_text", "label": "Result line", "default": "We would go with the [SIZE] pack", "info": "[SIZE] is Small, Medium or Large." },
    { "type": "text", "id": "note_text", "label": "Portion line", "default": "About [GRAMS]g a day — one pack lasts around [DAYS] days." },
    { "type": "text", "id": "empty_text", "label": "Before a weight is entered", "default": "Pop in a weight and we will size it." },
    { "type": "range", "id": "weight_default", "label": "Starting weight", "min": 1, "max": 60, "step": 1, "unit": "kg", "default": 14 },
    { "type": "header", "content": "Sizing rules" },
    { "type": "range", "id": "small_max", "label": "Small is up to", "min": 4, "max": 20, "step": 1, "unit": "kg", "default": 10 },
    { "type": "range", "id": "medium_max", "label": "Medium is up to", "min": 12, "max": 45, "step": 1, "unit": "kg", "default": 25 },
    { "type": "range", "id": "grams_per_kg", "label": "Food per kilo", "min": 10, "max": 40, "step": 1, "unit": "g", "default": 22 },
    { "type": "range", "id": "pack_small", "label": "Small pack", "min": 400, "max": 3000, "step": 100, "unit": "g", "default": 1200 },
    { "type": "range", "id": "pack_medium", "label": "Medium pack", "min": 800, "max": 5000, "step": 100, "unit": "g", "default": 2400 },
    { "type": "range", "id": "pack_large", "label": "Large pack", "min": 1500, "max": 8000, "step": 100, "unit": "g", "default": 4000 }
  ],
  "presets": [{ "name": "Size finder", "category": "t:categories.custom" }]
}
{% endschema %}
