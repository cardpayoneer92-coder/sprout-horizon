{% doc %}
  One short trust line with a tick — used in the hero's reassurance row.

  @example
  Vet approved
{% enddoc %}

{%- liquid
  assign b = block.settings
-%}

{%- if b.text != blank -%}
  <li class="sp-trust__item" {{ block.shopify_attributes }}>
    {% render 'sp-icon', name: b.icon, size: 18 %}
    <span>{{ b.text | escape }}</span>
  </li>
{%- endif -%}

{% stylesheet %}
  .sp-trust__item { display: flex; align-items: center; gap: 7px; font-size: 14px; font-weight: 700; }
  .sp-trust__item svg { flex: 0 0 auto; }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust line",
  "tag": null,
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Vet approved" },
    {
      "type": "select", "id": "icon", "label": "Icon", "default": "check",
      "options": [
        { "value": "check", "label": "Tick" },
        { "value": "leaf", "label": "Leaf" },
        { "value": "shield", "label": "Shield" },
        { "value": "paw", "label": "Paw" },
        { "value": "heart", "label": "Heart" },
        { "value": "truck", "label": "Delivery" }
      ]
    }
  ],
  "presets": [{ "name": "Trust line", "category": "t:categories.custom" }]
}
{% endschema %}
