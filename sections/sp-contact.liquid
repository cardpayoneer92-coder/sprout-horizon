{% comment %}
  Section contract.
  The contact page: a form on the left, reassurance cards on the right — how
  fast we answer, where we are, and the quickest self-serve answers.
  @example
  <!-- Say hello — we answer within a day -->
{% endcomment %}

{%- liquid
  assign s = section.settings
-%}

<section class="sp-sec sp-contact" style="--sp-sec-bg: {{ s.background }}; padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px;">
  <div class="sp-wrap">
    <header class="sp-contact__head sp-reveal">
      {%- if s.eyebrow != blank -%}<p class="sp-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      <h1 class="sp-h2">{{ page.title | default: s.fallback_title }}</h1>
      {%- if s.text != blank -%}<p class="sp-lede sp-contact__lede">{{ s.text | escape }}</p>{%- endif -%}
    </header>

    <div class="sp-contact__grid">
      <div class="sp-contact__form-card sp-reveal">
        {%- form 'contact', class: 'sp-contact__form' -%}
          {%- if form.posted_successfully? -%}
            <p class="sp-contact__ok" role="status">{{ s.success | escape }}</p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="sp-contact__bad" role="alert">{{ form.errors | default_errors }}</p>
          {%- endif -%}

          <label class="sp-field">
            <span>Your name</span>
            <input type="text" name="contact[name]" value="{{ form.name }}" autocomplete="name" required>
          </label>
          <label class="sp-field">
            <span>Email</span>
            <input type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required>
          </label>
          <label class="sp-field">
            <span>Your pet's name (optional)</span>
            <input type="text" name="contact[Pet]" value="">
          </label>
          <label class="sp-field">
            <span>How can we help?</span>
            <textarea name="contact[body]" rows="5" required>{{ form.body }}</textarea>
          </label>

          <button type="submit" class="sp-btn sp-btn--primary">{{ s.button_text | escape }}</button>
        {%- endform -%}
      </div>

      <aside class="sp-contact__side">
        {%- for i in (1..3) -%}
          {%- liquid
            case i
              when 1
                assign card_title = s.card1_title
                assign card_text = s.card1_text
                assign card_icon = 'clock'
                assign card_tint = '#d8edcd'
              when 2
                assign card_title = s.card2_title
                assign card_text = s.card2_text
                assign card_icon = 'truck'
                assign card_tint = '#fbe9d2'
              else
                assign card_title = s.card3_title
                assign card_text = s.card3_text
                assign card_icon = 'heart'
                assign card_tint = '#bfe3ef'
            endcase
          -%}
          {%- if card_title != blank -%}
            <div class="sp-contact__card sp-reveal" style="--sp-contact-tint: {{ card_tint }};">
              <span class="sp-contact__icon">{% render 'sp-icon', name: card_icon, size: 22 %}</span>
              <h2 class="sp-contact__card-title">{{ card_title | escape }}</h2>
              <p class="sp-contact__card-text">{{ card_text | escape }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}

        <div class="sp-contact__pets" aria-hidden="true">
          <span class="sp-bob">{% render 'sp-art', name: 'duo', size: 170 %}</span>
        </div>
      </aside>
    </div>
  </div>
</section>

{% stylesheet %}
  .sp-contact__head { display: grid; gap: 6px; margin-bottom: 32px; }
  .sp-contact__lede { max-width: 54ch; }
  .sp-contact__grid { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 28px; align-items: start; }

  .sp-contact__form-card { padding: 28px; border-radius: var(--sp-r-card, 28px); background: var(--sp-mint, #d8edcd); }
  .sp-contact__form { display: grid; gap: 16px; margin: 0; }
  .sp-field { display: grid; gap: 6px; font-size: 13px; font-weight: 700; }
  .sp-field input, .sp-field textarea { width: 100%; padding: 13px 18px; border: 2px solid #c9dac2; border-radius: 22px; background: var(--sp-cream, #fdfaf2); font-family: inherit; font-size: 16px; font-weight: 400; color: inherit; box-sizing: border-box; }
  .sp-field input { min-height: 50px; border-radius: 999px; }
  .sp-field textarea { resize: vertical; }
  .sp-field input:focus-visible, .sp-field textarea:focus-visible { outline: 3px solid var(--sp-moss, #2f7a46); outline-offset: 1px; }
  .sp-contact__form .sp-btn { justify-self: start; }
  .sp-contact__ok, .sp-contact__bad { margin: 0; padding: 13px 18px; border-radius: 20px; font-size: 15px; font-weight: 700; }
  .sp-contact__ok { background: var(--sp-cream, #fdfaf2); color: var(--sp-moss, #2f7a46); }
  .sp-contact__bad { background: var(--sp-coral, #ff8a6b); color: #fff; }

  .sp-contact__side { display: grid; gap: 14px; }
  .sp-contact__card { padding: 22px 24px; border-radius: var(--sp-r-card, 28px); background: var(--sp-contact-tint, #d8edcd); }
  .sp-contact__icon { display: inline-grid; place-items: center; width: 44px; height: 44px; margin-bottom: 10px; border-radius: 999px; background: var(--sp-cream, #fdfaf2); color: var(--sp-moss, #2f7a46); }
  .sp-contact__card-title { margin: 0 0 4px; font-family: var(--sp-font-head); font-size: 20px; font-weight: 500; }
  .sp-contact__card-text { margin: 0; font-size: 15px; color: var(--sp-muted, #566358); }
  .sp-contact__pets { display: grid; place-items: center; padding-top: 4px; }
  .sp-contact__pets .sp-art { width: 160px; height: auto; max-width: none; }

  @media (max-width: 989px) { .sp-contact__grid { grid-template-columns: minmax(0, 1fr); } }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact",
  "tag": "section",
  "class": "sp-contact-section",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "We are listening" },
    { "type": "text", "id": "fallback_title", "label": "Fallback title", "default": "Say hello" },
    { "type": "text", "id": "text", "label": "Text", "default": "Feeding questions, a late parcel, or a photo of your dog — all welcome." },
    { "type": "text", "id": "button_text", "label": "Button", "default": "Send it" },
    { "type": "text", "id": "success", "label": "Success message", "default": "Got it — we will come back to you within a day." },
    { "type": "header", "content": "Cards" },
    { "type": "text", "id": "card1_title", "label": "Card 1 title", "default": "We answer within a day" },
    { "type": "text", "id": "card1_text", "label": "Card 1 text", "default": "Real people, Monday to Friday, 9 to 5." },
    { "type": "text", "id": "card2_title", "label": "Card 2 title", "default": "Where is my order?" },
    { "type": "text", "id": "card2_text", "label": "Card 2 text", "default": "Tracking goes out the moment it leaves us." },
    { "type": "text", "id": "card3_title", "label": "Card 3 title", "default": "Fussy-eater promise" },
    { "type": "text", "id": "card3_text", "label": "Card 3 text", "default": "They turn their nose up, we refund it." },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "background", "label": "Background", "default": "#fdfaf2" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 64 }
  ]
}
{% endschema %}
