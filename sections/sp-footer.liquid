{% comment %}
  Section contract.
  Footer: a scalloped top edge with a dog and a cat peeking over it, a
  dashed newsletter card, link columns that wiggle on hover, a paw trail
  and the small print. Link columns are child blocks.
  @example
  <!-- Treats in your inbox · Shop / Help / About · Made for good dogs -->
{% endcomment %}

{%- liquid
  assign s = section.settings
-%}

<footer class="sp-footer" style="--sp-f-bg: {{ s.background }}; --sp-f-fg: {{ s.text_color }}; --sp-f-card: {{ s.card_background }};">
  {%- if s.scallop -%}
    <svg class="sp-footer__edge" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 60V26c60 0 60-26 120-26s60 26 120 26 60-26 120-26 60 26 120 26 60-26 120-26 60 26 120 26 60-26 120-26 60 26 120 26 60-26 120-26 60 26 120 26 60-26 120-26 60 26 120 26v34Z" fill="currentColor"></path>
    </svg>
  {%- endif -%}

  <div class="sp-footer__body">
    {%- if s.show_pets -%}
      <div class="sp-footer__pets" aria-hidden="true">
        <svg class="sp-bob" width="78" height="78" viewBox="0 0 48 48">
          <circle cx="24" cy="30" r="15" fill="#fbf7ef"></circle>
          <path d="M11 19c-3-7-1-11 3-11s8 4 9 9Z" fill="#c98f5e"></path>
          <path d="M37 19c3-7 1-11-3-11s-8 4-9 9Z" fill="#c98f5e"></path>
          <circle cx="18.5" cy="28" r="2.4" fill="#27372b"></circle>
          <circle cx="29.5" cy="28" r="2.4" fill="#27372b"></circle>
          <ellipse cx="24" cy="35" rx="3.8" ry="3" fill="#27372b"></ellipse>
        </svg>
        <svg class="sp-bob sp-bob--b" width="60" height="60" viewBox="0 0 48 48">
          <circle cx="24" cy="32" r="13" fill="#f7efe0"></circle>
          <path d="M13 23 11 11l11 6Z" fill="#9b8d7c"></path>
          <path d="M35 23 37 11l-11 6Z" fill="#9b8d7c"></path>
          <circle cx="19" cy="30" r="2.2" fill="#27372b"></circle>
          <circle cx="29" cy="30" r="2.2" fill="#27372b"></circle>
          <path d="M24 35v2M24 37c-3 0-5 1.6-5 3.6M24 37c3 0 5 1.6 5 3.6" stroke="#27372b" stroke-width="1.9" stroke-linecap="round" fill="none"></path>
        </svg>
      </div>
    {%- endif -%}

    <div class="sp-wrap">
      {%- if s.show_newsletter -%}
        <div class="sp-footer__news">
          <span class="sp-footer__news-art sp-bob" aria-hidden="true">
            <svg width="74" height="74" viewBox="0 0 48 48" focusable="false">
              <rect x="6" y="14" width="36" height="24" rx="7" fill="var(--sp-mint, #d8edcd)"></rect>
              <path d="M7 18l17 11 17-11" fill="none" stroke="var(--sp-moss, #2f7a46)" stroke-width="2.6" stroke-linecap="round"></path>
              <circle cx="38" cy="14" r="7" fill="var(--sp-sun, #ffd54a)"></circle>
            </svg>
          </span>
          <div class="sp-footer__news-copy">
            {%- if s.news_heading != blank -%}<h2 class="sp-h3">{{ s.news_heading }}</h2>{%- endif -%}
            {%- if s.news_text != blank -%}<p class="sp-footer__news-text">{{ s.news_text | escape }}</p>{%- endif -%}
          </div>
          {%- form 'customer', class: 'sp-footer__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="sp-visually-hidden" for="sp-news-{{ section.id }}">{{ s.news_placeholder | escape }}</label>
            <input
              id="sp-news-{{ section.id }}"
              class="sp-footer__input"
              type="email"
              name="contact[email]"
              placeholder="{{ s.news_placeholder | escape }}"
              autocomplete="email"
              required
            >
            <button type="submit" class="sp-btn sp-btn--primary">{{ s.news_button | escape }}</button>
            {%- if form.posted_successfully? -%}
              <p class="sp-footer__ok" role="status">{{ s.news_success | escape }}</p>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}

      <div class="sp-footer__cols">
        <div class="sp-footer__brand">
          <div class="sp-footer__logo">
            {% render 'sp-icon', name: 'leaf', size: 28 %}
            <span>{{ s.wordmark | default: shop.name }}</span>
          </div>
          {%- if s.blurb != blank -%}<p class="sp-footer__blurb">{{ s.blurb | escape }}</p>{%- endif -%}

          {%- liquid
            assign socials = ''
            if s.instagram_url != blank or s.tiktok_url != blank or s.pinterest_url != blank or s.facebook_url != blank
              assign socials = 'yes'
            endif
          -%}
          {%- if socials == 'yes' -%}
            <div class="sp-footer__socials">
              {%- if s.instagram_url != blank -%}
                <a class="sp-footer__social" href="{{ s.instagram_url }}" aria-label="Instagram">
                  <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="5"></rect><circle cx="12" cy="12" r="3.6"></circle><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"></circle></svg>
                </a>
              {%- endif -%}
              {%- if s.tiktok_url != blank -%}
                <a class="sp-footer__social" href="{{ s.tiktok_url }}" aria-label="TikTok">
                  <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 2h-2.9v12.1a2.6 2.6 0 1 1-2.1-2.55V8.6a5.6 5.6 0 1 0 5 5.57V8.9a6.6 6.6 0 0 0 3.9 1.26V7.2a3.8 3.8 0 0 1-3.9-3.78Z"></path></svg>
                </a>
              {%- endif -%}
              {%- if s.pinterest_url != blank -%}
                <a class="sp-footer__social" href="{{ s.pinterest_url }}" aria-label="Pinterest">
                  <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9.5 20.5 12 11"></path><circle cx="12" cy="12" r="9"></circle><path d="M9 13.5c-.6-2.6.9-5 3.4-5.2 2.2-.2 3.8 1.2 3.8 3.3 0 2.4-1.4 4.2-3.2 4.2-1 0-1.8-.8-1.6-1.8"></path></svg>
                </a>
              {%- endif -%}
              {%- if s.facebook_url != blank -%}
                <a class="sp-footer__social" href="{{ s.facebook_url }}" aria-label="Facebook">
                  <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5h1.65V3.6A22 22 0 0 0 14.3 3.5c-2.4 0-4 1.45-4 4.12V9.9H7.6V13h2.7v8Z"></path></svg>
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        {%- for i in (1..3) -%}
          {%- liquid
            case i
              when 1
                assign col_title = s.col1_title
                assign col_menu = s.col1_menu
                assign col_links = s.col1_links
              when 2
                assign col_title = s.col2_title
                assign col_menu = s.col2_menu
                assign col_links = s.col2_links
              else
                assign col_title = s.col3_title
                assign col_menu = s.col3_menu
                assign col_links = s.col3_links
            endcase
          -%}
          {%- if col_title != blank -%}
            <div class="sp-footer__col">
              <h3 class="sp-footer__col-title">{{ col_title | escape }}</h3>
              <ul class="sp-footer__list" role="list">
                {%- if col_menu != blank -%}
                  {%- for link in linklists[col_menu].links -%}
                    <li><a class="sp-flink" href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                {%- else -%}
                  {%- assign rows = col_links | newline_to_br | split: '<br />' -%}
                  {%- for row in rows -%}
                    {%- assign parts = row | strip | split: '|' -%}
                    {%- assign label = parts[0] | strip -%}
                    {%- if label != blank -%}
                      <li><a class="sp-flink" href="{{ parts[1] | strip | default: '#' }}">{{ label }}</a></li>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endfor -%}

        {% content_for 'blocks' %}
      </div>

      {%- if s.show_wordmark -%}
        <div class="sp-footer__big" aria-hidden="true">
          <span>{{ s.wordmark | default: shop.name }}</span>
        </div>
      {%- endif -%}

      {%- if s.show_paws -%}
        <div class="sp-footer__trail" aria-hidden="true">
          <span style="--sp-r: -18deg; opacity: .4">{% render 'sp-icon', name: 'paw', size: 20 %}</span>
          <span style="--sp-r: 12deg; opacity: .33">{% render 'sp-icon', name: 'paw', size: 16 %}</span>
          <span style="--sp-r: -8deg; opacity: .45">{% render 'sp-icon', name: 'paw', size: 22 %}</span>
          <span class="sp-footer__dash"></span>
          <span style="--sp-r: 20deg; opacity: .36">{% render 'sp-icon', name: 'paw', size: 18 %}</span>
        </div>
      {%- endif -%}

      <div class="sp-footer__fine">
        <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
        {%- for policy in shop.policies -%}
          {%- if policy != blank -%}<a class="sp-flink" href="{{ policy.url }}">{{ policy.title }}</a>{%- endif -%}
        {%- endfor -%}
        {%- if s.sign_off != blank -%}
          <span class="sp-footer__signoff">{{ s.sign_off | escape }} {% render 'sp-icon', name: 'heart', size: 15 %}</span>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% stylesheet %}
  .sp-footer { position: relative; margin-top: 40px; color: var(--sp-f-fg, #27372b); }
  .sp-footer__edge { display: block; width: 100%; height: 60px; color: var(--sp-f-bg, #e7f0e2); }
  .sp-footer__body { position: relative; background: var(--sp-f-bg, #e7f0e2); padding-top: 40px; }
  .sp-footer__pets { position: absolute; top: -58px; right: 9%; display: flex; align-items: flex-end; gap: 14px; pointer-events: none; }

  .sp-footer__news { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; padding: 28px 32px; margin-bottom: 38px; border: 2px dashed #c6d8be; border-radius: var(--sp-r-band, 36px); background: var(--sp-f-card, #fbf7ef); }
  .sp-footer__news-copy { flex: 1 1 280px; min-width: 0; }
  .sp-footer__news-text { margin: 4px 0 0; font-size: 15px; color: var(--sp-muted, #566358); }
  .sp-footer__form { flex: 1 1 320px; min-width: 0; display: flex; flex-wrap: wrap; gap: 10px; margin: 0; }
  .sp-footer__input { flex: 1 1 180px; min-width: 0; min-height: 52px; padding: 0 20px; border: 2px solid #ddd5c6; border-radius: 999px; background: var(--sp-cream, #fbf7ef); font-family: inherit; font-size: 16px; color: inherit; }
  .sp-footer__ok { flex: 1 1 100%; margin: 0; font-size: 14px; font-weight: 700; color: var(--sp-moss, #3f6b4a); }

  .sp-footer__cols { display: flex; flex-wrap: wrap; gap: 36px; padding-bottom: 30px; }
  .sp-footer__brand { flex: 1 1 260px; min-width: 0; }
  .sp-footer__logo { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; font-family: var(--sp-font-head); font-size: 28px; font-weight: 600; letter-spacing: -0.02em; color: var(--sp-moss, #3f6b4a); }
  .sp-footer__blurb { margin: 0 0 18px; font-size: 15px; color: var(--sp-muted, #566358); max-width: 32ch; }

  .sp-footer__news-art { flex: 0 0 auto; display: inline-flex; }
  .sp-footer__socials { display: flex; gap: 8px; }
  .sp-footer__social { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 999px; background: var(--sp-f-card, #fdfaf2); color: var(--sp-moss, #2f7a46); transition: background-color 0.18s ease, color 0.18s ease, translate 0.24s var(--sp-ease); }
  .sp-footer__social:hover { translate: 0 -3px; background: var(--sp-sun, #ffd54a); color: var(--sp-ink, #27372b); }
  .sp-footer__social:focus-visible { outline: 3px solid var(--sp-moss, #2f7a46); outline-offset: 3px; }

  .sp-footer__col { flex: 1 1 150px; min-width: 0; }
  .sp-footer__col-title { margin: 0 0 14px; font-family: var(--sp-font-head); font-size: 19px; font-weight: 500; }
  .sp-footer__list { margin: 0; padding: 0; list-style: none; display: grid; gap: 10px; font-size: 15px; }
  /* Same language as the header nav: no tilt, just a dash that grows from
     the left and a colour shift. */
  .sp-flink { position: relative; display: inline-block; color: inherit; text-decoration: none; transition: color 0.18s ease; }
  .sp-flink::after { content: ""; position: absolute; left: 0; right: 0; bottom: -3px; height: 2px; border-radius: 999px; background: var(--sp-moss, #2f7a46); transform: scaleX(0); transform-origin: left center; transition: transform 0.24s var(--sp-ease); }
  .sp-flink:hover { color: var(--sp-moss, #2f7a46); }
  .sp-flink:hover::after { transform: scaleX(1); }
  .sp-flink:focus-visible { outline: 3px solid var(--sp-moss, #2f7a46); outline-offset: 3px; border-radius: 4px; }

  .sp-footer__big { position: relative; margin: 6px 0 -2px; overflow: hidden; line-height: .78; text-align: center; pointer-events: none; user-select: none; }
  .sp-footer__big span { display: block; font-family: var(--sp-font-head); font-size: clamp(64px, 17vw, 240px); font-weight: 600; letter-spacing: -0.045em; color: transparent; background-image: linear-gradient(to bottom, var(--sp-moss) 42%, rgb(47 122 70 / 0) 94%); -webkit-background-clip: text; background-clip: text; }

  .sp-footer__trail { display: flex; align-items: center; gap: 18px; padding-bottom: 14px; color: var(--sp-leaf, #9cc48f); }
  .sp-footer__trail > span { display: inline-flex; transform: rotate(var(--sp-r, 0deg)); }
  .sp-footer__dash { flex: 1 1 auto; height: 2px; background: repeating-linear-gradient(90deg, #c6d8be 0 10px, transparent 10px 20px); }

  .sp-footer__fine { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 24px; padding: 10px 0 32px; border-top: 1px solid #d3e0cd; font-size: 13px; color: var(--sp-muted, #566358); }
  .sp-footer__signoff { margin-left: auto; display: inline-flex; align-items: center; gap: 7px; font-weight: 700; color: var(--sp-moss, #3f6b4a); }
  .sp-footer__signoff svg { color: #e08a7a; }

  .sp-visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media (max-width: 749px) {
    .sp-footer__pets { right: 5%; top: -46px; }
    .sp-footer__pets svg { width: 58px; height: 58px; }
    .sp-footer__signoff { margin-left: 0; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "tag": "footer",
  "class": "sp-footer-section",
  "blocks": [
    {
      "type": "_sp-footer-menu"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "checkbox",
      "id": "show_wordmark",
      "label": "Giant wordmark",
      "default": true
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark",
      "info": "Leave empty to use the store name."
    },
    {
      "type": "textarea",
      "id": "blurb",
      "label": "Blurb",
      "default": "Gently cooked food and sensible treats for dogs, cats and the small ones."
    },
    {
      "type": "text",
      "id": "sign_off",
      "label": "Sign-off",
      "default": "Made for good dogs (and cats)"
    },
    {
      "type": "header",
      "content": "Social"
    },
    { "type": "url", "id": "instagram_url", "label": "Instagram" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok" },
    { "type": "url", "id": "pinterest_url", "label": "Pinterest" },
    { "type": "url", "id": "facebook_url", "label": "Facebook" },
    {
      "type": "header",
      "content": "Link columns",
      "info": "Pick a menu, or type one link per line as Label | /url."
    },
    { "type": "text", "id": "col1_title", "label": "Column 1 heading", "default": "Shop" },
    { "type": "link_list", "id": "col1_menu", "label": "Column 1 menu" },
    { "type": "textarea", "id": "col1_links", "label": "Column 1 links", "default": "Dog | /collections/all\nCat | /collections/all\nSmall pets | /collections/all\nBundles | /collections/all" },
    { "type": "text", "id": "col2_title", "label": "Column 2 heading", "default": "Help" },
    { "type": "link_list", "id": "col2_menu", "label": "Column 2 menu" },
    { "type": "textarea", "id": "col2_links", "label": "Column 2 links", "default": "Size finder | /pages/size-finder\nFeeding guide | /pages/feeding-guide\nDelivery | /policies/shipping-policy\nReturns | /policies/refund-policy" },
    { "type": "text", "id": "col3_title", "label": "Column 3 heading", "default": "About" },
    { "type": "link_list", "id": "col3_menu", "label": "Column 3 menu" },
    { "type": "textarea", "id": "col3_links", "label": "Column 3 links", "default": "Our story | /pages/story\nIngredients | /pages/ingredients\nSustainability | /pages/sustainability\nGifting | /pages/gifting" },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show the sign-up",
      "default": true
    },
    {
      "type": "textarea",
      "id": "news_heading",
      "label": "Heading",
      "default": "Treats in your inbox"
    },
    {
      "type": "text",
      "id": "news_text",
      "label": "Text",
      "default": "New recipes, feeding tips and far too many dog photos."
    },
    {
      "type": "text",
      "id": "news_placeholder",
      "label": "Placeholder",
      "default": "you@example.com"
    },
    {
      "type": "text",
      "id": "news_button",
      "label": "Button",
      "default": "Sign up"
    },
    {
      "type": "text",
      "id": "news_success",
      "label": "Thanks message",
      "default": "You're in \u2014 watch your inbox."
    },
    {
      "type": "header",
      "content": "Decoration"
    },
    {
      "type": "checkbox",
      "id": "scallop",
      "label": "Scalloped top edge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pets",
      "label": "Peeking pets",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_paws",
      "label": "Paw trail",
      "default": true
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#e7f0e2"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Newsletter card",
      "default": "#fbf7ef"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#27372b"
    }
  ],
  "enabled_on": {
    "groups": [
      "footer"
    ]
  }
}
{% endschema %}
