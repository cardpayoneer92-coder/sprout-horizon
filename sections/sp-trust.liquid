{% comment %}
  Section contract.
  A calm row of trust points between hairlines — the reassurance a pet
  owner wants before buying food, without the sticker noise. Points are
  child blocks.
  @example
  <!-- Vet-formulated · Six ingredients · Compostable packs · Fussy-eater promise -->
{% endcomment %}

{%- liquid
  assign s = section.settings
-%}

{%- if section.blocks.size > 0 or request.design_mode -%}
<section class="sp-sec sp-trustrow-sec" style="--sp-sec-bg: {{ s.background }}; --sp-trust-cols: {{ s.columns }}; padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px;">
  <div class="sp-wrap">
    {%- if s.heading != blank -%}
      <h2 class="sp-h3 sp-trustrow__heading">{{ s.heading }}</h2>
    {%- endif -%}
    <div class="sp-trustrow sp-reveal sp-trustrow--{{ s.style }}">{% content_for 'blocks' %}</div>
  </div>
</section>
{%- endif -%}

{% stylesheet %}
  .sp-trustrow__heading { margin-bottom: 20px; }

  /* Each point gets equal width and a hairline between, so the four read as
     one row rather than four blocks drifting in a slab. */
  .sp-trustrow { display: grid; grid-template-columns: repeat(var(--sp-trust-cols, 4), minmax(0, 1fr)); gap: 0; }
  .sp-trustrow > * { padding-inline: clamp(16px, 2vw, 26px); }
  .sp-trustrow > * + * { border-left: 1px solid var(--sp-line-mint, #c6dcb9); }
  .sp-trustrow > :first-child { padding-inline-start: 0; }
  .sp-trustrow > :last-child { padding-inline-end: 0; }

  .sp-trustrow--lines { padding-block: 30px; border-top: 1px solid var(--sp-line, #e3dccd); border-bottom: 1px solid var(--sp-line, #e3dccd); }
  .sp-trustrow--band { padding: 32px clamp(24px, 3vw, 38px); border-radius: var(--sp-r-band, 36px); background: var(--sp-mint, #d8edcd); }
  .sp-trustrow--band > * + * { border-left-color: rgb(47 122 70 / 0.16); }

  @media (max-width: 1099px) {
    .sp-trustrow { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 26px; }
    .sp-trustrow > * { padding-inline: 0; border-left: 0; }
    .sp-trustrow > :nth-child(odd) { padding-inline-end: clamp(16px, 2vw, 26px); }
    .sp-trustrow > :nth-child(even) { padding-inline-start: clamp(16px, 2vw, 26px); border-left: 1px solid var(--sp-line-mint, #c6dcb9); }
    .sp-trustrow--band > :nth-child(even) { border-left-color: rgb(47 122 70 / 0.16); }
  }
  @media (max-width: 599px) {
    .sp-trustrow { grid-template-columns: minmax(0, 1fr); row-gap: 20px; }
    .sp-trustrow > * { padding-inline: 0 !important; border-left: 0 !important; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sp-reveal, .sp-reveal.is-in, .sp-reveal.is-in > * { animation: none; opacity: 1; translate: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust row",
  "tag": "section",
  "class": "sp-trust-section",
  "blocks": [{ "type": "_sp-trust-line" }],
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Heading" },
    { "type": "range", "id": "columns", "label": "Columns", "min": 2, "max": 4, "step": 1, "default": 4 },
    {
      "type": "select", "id": "style", "label": "Style", "default": "lines",
      "options": [{ "value": "lines", "label": "Hairlines" }, { "value": "band", "label": "Mint band" }]
    },
    { "type": "color", "id": "background", "label": "Background", "default": "#fbf7ef" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 24 }
  ],
  "presets": [
    {
      "name": "Trust row",
      "category": "t:categories.custom",
      "blocks": [
        { "type": "_sp-trust-line", "settings": { "title": "Vet-formulated", "text": "Written with a veterinary nutritionist", "icon": "shield" } },
        { "type": "_sp-trust-line", "settings": { "title": "Six ingredients", "text": "Everything fits on the front of the pack", "icon": "leaf" } },
        { "type": "_sp-trust-line", "settings": { "title": "Compostable packs", "text": "Plant film and paper outers, no plastic", "icon": "bowl" } },
        { "type": "_sp-trust-line", "settings": { "title": "Fussy-eater promise", "text": "They turn their nose up, we refund it", "icon": "refresh" } }
      ]
    }
  ]
}
{% endschema %}
