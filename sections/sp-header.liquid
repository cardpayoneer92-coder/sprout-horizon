{% comment %}
  Section contract.
  The header: a sticky cream bar with the wordmark, a menu whose links lift
  on hover, and search / account / cart. On a phone the menu folds into a
  drawer. The menu comes from a setting rather than blocks, because a
  section group will not carry blocks.
  @example
  <!-- sprout · Dogs Cats Small pets Bundles · search account cart -->
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign menu = linklists[s.menu]
-%}

<sp-header
  class="sp-head{% if s.sticky %} sp-head--sticky{% endif %}"
  style="--sp-head-bg: {{ s.background }}; --sp-head-fg: {{ s.text_color }}; --sp-head-accent: {{ s.accent }};"
>
  <div class="sp-head__bar sp-wrap">

    <button type="button" class="sp-head__burger sp-icon-btn" aria-label="Menu" aria-expanded="false" aria-controls="sp-drawer-{{ section.id }}" data-burger>
      <span class="sp-visually-hidden" aria-hidden="true">Menu</span>
      <span class="sp-head__burger-bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>

    <a class="sp-head__logo" href="{{ routes.root_url }}">
      {%- if s.logo != blank -%}
        <img
          src="{{ s.logo | image_url: width: 400 }}"
          alt="{{ shop.name | escape }}"
          width="{{ s.logo.width }}"
          height="{{ s.logo.height }}"
          style="height: {{ s.logo_height }}px; width: auto;"
        >
      {%- else -%}
        <span class="sp-head__leaf sp-wiggle" aria-hidden="true">{% render 'sp-icon', name: 'leaf', size: 26 %}</span>
        <span class="sp-head__word">{{ s.wordmark | default: shop.name }}</span>
      {%- endif -%}
    </a>

    {%- if menu != blank and menu.links.size > 0 -%}
      <nav class="sp-head__nav" aria-label="Main">
        <ul role="list">
          {%- for link in menu.links -%}
            <li>
              <a class="sp-head__link{% if link.active %} is-on{% endif %}" href="{{ link.url }}">
                <span>{{ link.title }}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <div class="sp-head__tools">
      {%- if s.show_search -%}
        <a class="sp-icon-btn" href="{{ routes.search_url }}" aria-label="Search">
          {% render 'sp-icon', name: 'search', size: 20 %}
        </a>
      {%- endif -%}
      {%- if s.show_account and shop.customer_accounts_enabled -%}
        <a class="sp-icon-btn" href="{{ routes.account_url }}" aria-label="Account">
          {% render 'sp-icon', name: 'user', size: 20 %}
        </a>
      {%- endif -%}
      {%- if s.show_wishlist -%}
        {%- assign wish_url = s.wishlist_link | default: '/pages/wishlist' -%}
        <a class="sp-icon-btn sp-head__wish" href="{{ wish_url }}" aria-label="Wishlist">
          {% render 'sp-icon', name: 'heart', size: 20 %}
          <span class="sp-head__count is-empty" data-wish-count>0</span>
        </a>
        <script>window.SproutWishlistText = { url: {{ wish_url | json }}, added: {{ s.wishlist_added | json }}, removed: {{ s.wishlist_removed | json }}, view: {{ s.wishlist_view | json }} };</script>
      {%- endif -%}
      <a class="sp-icon-btn sp-head__cart" href="{{ routes.cart_url }}" aria-label="Cart">
        {% render 'sp-icon', name: 'bag', size: 20 %}
        <span class="sp-head__count{% if cart.item_count == 0 %} is-empty{% endif %}" data-cart-count>{{ cart.item_count }}</span>
      </a>
      {%- if s.button_text != blank -%}
        <a class="sp-btn sp-btn--primary sp-btn--sm sp-head__cta" href="{{ s.button_link | default: '/collections/all' }}">{{ s.button_text | escape }}</a>
      {%- endif -%}
    </div>
  </div>

  {%- if menu != blank and menu.links.size > 0 -%}
    <div class="sp-head__drawer" id="sp-drawer-{{ section.id }}" hidden data-drawer>
      <ul role="list">
        {%- for link in menu.links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</sp-header>

<script type="module">
  if (!customElements.get('sp-header')) {
    customElements.define('sp-header', class extends HTMLElement {
      connectedCallback() {
        this.burger = this.querySelector('[data-burger]');
        this.drawer = this.querySelector('[data-drawer]');
        if (this.burger && this.drawer) {
          this.burger.addEventListener('click', () => this.toggle());
        }
        // Horizon scrolls .page-wrapper, not the window, so listen there.
        this.scroller = this.closest('.page-wrapper') || document.querySelector('.page-wrapper') || window;
        this.onScroll = () => {
          const y = this.scroller === window ? window.scrollY : this.scroller.scrollTop;
          this.classList.toggle('is-stuck', y > 8);
        };
        this.onScroll();
        this.scroller.addEventListener('scroll', this.onScroll, { passive: true });

        // anything that adds to the bag without a page load tells us here
        this.onCart = async () => {
          try {
            const cart = await fetch('/cart.js', { headers: { Accept: 'application/json' } }).then((r) => r.json());
            const badge = this.querySelector('[data-cart-count]');
            if (!badge) return;
            badge.textContent = cart.item_count;
            badge.classList.toggle('is-empty', cart.item_count === 0);
          } catch (e) { /* leave the badge as it was */ }
        };
        document.addEventListener('sprout:cart-change', this.onCart);
      }

      disconnectedCallback() {
        if (this.scroller) this.scroller.removeEventListener('scroll', this.onScroll);
        document.removeEventListener('sprout:cart-change', this.onCart);
      }

      toggle() {
        const open = this.burger.getAttribute('aria-expanded') === 'true';
        this.burger.setAttribute('aria-expanded', String(!open));
        this.drawer.hidden = open;
        this.classList.toggle('is-open', !open);
      }
    });
  }
</script>

{% stylesheet %}
  /* The section tag wraps this element, so the wrapper is what sticks —
     a sticky child would only stick inside its own box. */
  .sp-header-section:has(.sp-head--sticky) { position: sticky; top: 0; z-index: 40; }
  .sp-head { display: block; position: relative; z-index: 40; background: var(--sp-head-bg, #fdfaf2); color: var(--sp-head-fg, #27372b); transition: box-shadow 0.25s ease; }
  .sp-head.is-stuck { box-shadow: 0 6px 20px rgb(39 55 43 / 0.08); }

  .sp-head__bar { display: flex; align-items: center; gap: 18px; min-height: 72px; padding-block: 10px; }

  .sp-head__logo { display: inline-flex; align-items: center; gap: 9px; color: var(--sp-moss, #2f7a46); text-decoration: none; flex: 0 0 auto; }
  .sp-head__word { font-family: var(--sp-font-head); font-size: 28px; font-weight: 600; letter-spacing: -0.02em; }
  .sp-head__leaf { display: inline-flex; }

  .sp-head__nav { flex: 1 1 auto; min-width: 0; }
  .sp-head__nav ul { display: flex; flex-wrap: wrap; gap: 4px; margin: 0; padding: 0; list-style: none; }
  .sp-head__link { position: relative; display: inline-block; padding: 9px 15px; border-radius: 999px; color: inherit; text-decoration: none; font-weight: 700; font-size: 15px; transition: background-color 0.18s ease, color 0.18s ease; }
  .sp-head__link:hover { background: var(--sp-mint, #d8edcd); }
  /* the marker grows from the middle on hover and stays put when active */
  .sp-head__link::after { content: ""; position: absolute; left: 50%; bottom: 3px; width: 16px; height: 3px; border-radius: 999px; background: var(--sp-head-accent, #6cb359); transform: translateX(-50%) scaleX(0); transform-origin: center; transition: transform 0.24s var(--sp-ease); }
  .sp-head__link:hover::after { transform: translateX(-50%) scaleX(1); }
  .sp-head__link.is-on { background: var(--sp-mint, #d8edcd); }
  .sp-head__link.is-on::after { transform: translateX(-50%) scaleX(1); }

  .sp-head__tools { display: flex; align-items: center; gap: 4px; flex: 0 0 auto; margin-left: auto; }
  .sp-head__cta { margin-left: 8px; }
  .sp-head__cart, .sp-head__wish { position: relative; }
  .sp-head__count { position: absolute; top: 2px; right: 0; min-width: 19px; height: 19px; padding: 0 5px; border-radius: 999px; background: var(--sp-coral, #ff8a6b); color: #fff; font-size: 11px; font-weight: 700; line-height: 19px; text-align: center; }
  .sp-head__count.is-empty { display: none; }

  .sp-head .sp-head__burger { display: none; }
  .sp-head__burger-bars { display: grid; gap: 4px; width: 20px; }
  .sp-head__burger-bars span { display: block; height: 2.5px; border-radius: 2px; background: currentColor; transition: transform 0.26s var(--sp-ease), opacity 0.2s ease; }
  .sp-head.is-open .sp-head__burger-bars span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .sp-head.is-open .sp-head__burger-bars span:nth-child(2) { opacity: 0; }
  .sp-head.is-open .sp-head__burger-bars span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  .sp-head__drawer { border-top: 1px solid var(--sp-line-mint, #d6e2d0); background: var(--sp-head-bg, #fdfaf2); }
  .sp-head__drawer ul { margin: 0; padding: 8px 24px 18px; list-style: none; display: grid; gap: 2px; }
  .sp-head__drawer a { display: block; padding: 13px 14px; border-radius: 18px; color: inherit; text-decoration: none; font-weight: 700; font-size: 17px; }
  .sp-head__drawer a:hover { background: var(--sp-mint, #d8edcd); }

  @media (max-width: 989px) {
    .sp-head__nav { display: none; }
    .sp-head .sp-head__burger { display: grid; }
    .sp-head__logo { margin-right: auto; }
    .sp-head .sp-head__cta { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .sp-head__link::after { transition: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "tag": "header",
  "class": "sp-header-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Leave empty to use the wordmark." },
    { "type": "range", "id": "logo_height", "label": "Logo height", "min": 20, "max": 70, "step": 2, "unit": "px", "default": 36 },
    { "type": "text", "id": "wordmark", "label": "Wordmark", "info": "Leave empty to use the store name." },
    { "type": "header", "content": "Menu" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "header", "content": "Tools" },
    { "type": "checkbox", "id": "show_search", "label": "Search", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Account", "default": true },
    { "type": "checkbox", "id": "show_wishlist", "label": "Wishlist", "default": true, "info": "Hearts on product cards save to a list kept on the shopper's device." },
    { "type": "url", "id": "wishlist_link", "label": "Wishlist page", "info": "A page using the 'wishlist' template. Defaults to /pages/wishlist." },
    { "type": "text", "id": "wishlist_added", "label": "Saved message", "default": "Saved to your wishlist" },
    { "type": "text", "id": "wishlist_removed", "label": "Removed message", "default": "Removed from your wishlist" },
    { "type": "text", "id": "wishlist_view", "label": "View link", "default": "View" },
    { "type": "text", "id": "button_text", "label": "Button", "default": "Shop by pet" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Style" },
    { "type": "checkbox", "id": "sticky", "label": "Stick to the top", "default": true },
    { "type": "color", "id": "background", "label": "Background", "default": "#fdfaf2" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#27372b" },
    { "type": "color", "id": "accent", "label": "Active marker", "default": "#6cb359" }
  ]
}
{% endschema %}
