{% comment %}
  Section contract.
  A slim bar above the header. Up to four lines take turns, each sliding up
  as the last one leaves, with a paw between the bar and the page. Lines are
  settings rather than blocks, because a section group will not carry blocks.
  @example
  <!-- Free shipping over [AMOUNT] · Vet approved recipes -->
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign lines = ''
  if s.msg1 != blank
    assign lines = lines | append: s.msg1 | append: '~~'
  endif
  if s.msg2 != blank
    assign lines = lines | append: s.msg2 | append: '~~'
  endif
  if s.msg3 != blank
    assign lines = lines | append: s.msg3 | append: '~~'
  endif
  if s.msg4 != blank
    assign lines = lines | append: s.msg4 | append: '~~'
  endif
  assign items = lines | split: '~~'
-%}

{%- if items.size > 0 -%}
  <sp-announce
    class="sp-announce"
    data-interval="{{ s.interval }}"
    style="--sp-ann-bg: {{ s.background }}; --sp-ann-fg: {{ s.text_color }}; --sp-ann-size: {{ s.text_size }}px;"
  >
    <div class="sp-announce__inner">
      {%- if s.show_icon -%}
        <span class="sp-announce__paw sp-wiggle" aria-hidden="true">{% render 'sp-icon', name: 'paw', size: 16 %}</span>
      {%- endif -%}

      <div class="sp-announce__stage" role="status" aria-live="polite">
        {%- for item in items -%}
          <span class="sp-announce__line{% if forloop.first %} is-on{% endif %}" data-line>
            {%- if s.link != blank -%}
              <a href="{{ s.link }}">{{ item }}</a>
            {%- else -%}
              {{ item }}
            {%- endif -%}
          </span>
        {%- endfor -%}
      </div>

      {%- if s.show_icon -%}
        <span class="sp-announce__paw sp-wiggle sp-announce__paw--b" aria-hidden="true">{% render 'sp-icon', name: 'paw', size: 16 %}</span>
      {%- endif -%}
    </div>
  </sp-announce>

  <script type="module">
    if (!customElements.get('sp-announce')) {
      customElements.define('sp-announce', class extends HTMLElement {
        connectedCallback() {
          this.lines = [...this.querySelectorAll('[data-line]')];
          if (this.lines.length < 2) return;
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          this.at = 0;
          const wait = (Number(this.dataset.interval) || 4) * 1000;
          this.timer = setInterval(() => this.step(), wait);
        }

        disconnectedCallback() { clearInterval(this.timer); }

        step() {
          const leaving = this.lines[this.at];
          this.at = (this.at + 1) % this.lines.length;
          const entering = this.lines[this.at];
          leaving.classList.remove('is-on');
          leaving.classList.add('is-out');
          entering.classList.add('is-on');
          setTimeout(() => leaving.classList.remove('is-out'), 520);
        }
      });
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .sp-announce { display: block; background: var(--sp-ann-bg, #2f7a46); color: var(--sp-ann-fg, #fdfaf2); }
  .sp-announce__inner { display: flex; align-items: center; justify-content: center; gap: 14px; min-height: 42px; padding: 6px 16px; }
  .sp-announce__paw { display: inline-flex; opacity: 0.72; }
  .sp-announce__paw--b { transform: scaleX(-1); animation-delay: -0.8s; }

  .sp-announce__stage { position: relative; display: grid; place-items: center; min-width: 0; height: 1.5em; }
  .sp-announce__line {
    grid-area: 1 / 1; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    font-size: var(--sp-ann-size, 14px); font-weight: 700; letter-spacing: 0.01em;
    opacity: 0; transform: translateY(100%); pointer-events: none;
  }
  .sp-announce__line a { color: inherit; text-decoration: none; border-bottom: 1px solid currentColor; }
  /* the old line clears out first, then the new one arrives, so the two are
     never on screen together */
  .sp-announce__line.is-on { opacity: 1; transform: translateY(0); pointer-events: auto; animation: sp-ann-in 0.34s var(--sp-ease, cubic-bezier(0.2, 0.7, 0.2, 1)) 0.26s both; }
  .sp-announce__line.is-out { opacity: 0; animation: sp-ann-out 0.26s var(--sp-ease, cubic-bezier(0.2, 0.7, 0.2, 1)) both; }

  @keyframes sp-ann-in { from { opacity: 0; transform: translateY(110%); } to { opacity: 1; transform: translateY(0); } }
  @keyframes sp-ann-out { from { opacity: 1; transform: translateY(0); } to { opacity: 0; transform: translateY(-110%); } }

  @media (prefers-reduced-motion: reduce) {
    .sp-announce__line.is-on, .sp-announce__line.is-out { animation: none; }
    .sp-announce__paw { animation: none; }
  }
  @media (max-width: 749px) { .sp-announce__inner { gap: 10px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "aside",
  "class": "sp-announcement-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "text", "id": "msg1", "label": "Line 1", "default": "Free shipping over [AMOUNT]" },
    { "type": "text", "id": "msg2", "label": "Line 2", "default": "Vet approved recipes, cooked this week" },
    { "type": "text", "id": "msg3", "label": "Line 3", "default": "Skip or cancel a delivery any time" },
    { "type": "text", "id": "msg4", "label": "Line 4", "default": "Compostable packaging, always" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "range", "id": "interval", "label": "Seconds per line", "min": 2, "max": 10, "step": 1, "unit": "sec", "default": 4 },
    { "type": "checkbox", "id": "show_icon", "label": "Paws on each side", "default": true },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "background", "label": "Background", "default": "#2f7a46" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#fdfaf2" },
    { "type": "range", "id": "text_size", "label": "Text size", "min": 11, "max": 18, "step": 1, "unit": "px", "default": 14 }
  ]
}
{% endschema %}
