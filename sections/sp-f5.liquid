<footer class="sp-x"></footer>

{% schema %}
{
  "name": "F5",
  "tag": "footer",
  "class": "sp-footer-section",
  "blocks": [
    {
      "type": "_sp-footer-menu"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark",
      "info": "Leave empty to use the store name."
    },
    {
      "type": "textarea",
      "id": "blurb",
      "label": "Blurb",
      "default": "Gently cooked food and sensible treats for dogs, cats and the small ones."
    },
    {
      "type": "text",
      "id": "sign_off",
      "label": "Sign-off",
      "default": "Made for good dogs (and cats)"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show the sign-up",
      "default": true
    },
    {
      "type": "textarea",
      "id": "news_heading",
      "label": "Heading",
      "default": "Treats in your inbox"
    },
    {
      "type": "text",
      "id": "news_text",
      "label": "Text",
      "default": "New recipes, feeding tips and far too many dog photos."
    },
    {
      "type": "text",
      "id": "news_placeholder",
      "label": "Placeholder",
      "default": "you@example.com"
    },
    {
      "type": "text",
      "id": "news_button",
      "label": "Button",
      "default": "Sign up"
    },
    {
      "type": "text",
      "id": "news_success",
      "label": "Thanks message",
      "default": "You're in \u2014 watch your inbox."
    },
    {
      "type": "header",
      "content": "Decoration"
    },
    {
      "type": "checkbox",
      "id": "scallop",
      "label": "Scalloped top edge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pets",
      "label": "Peeking pets",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_paws",
      "label": "Paw trail",
      "default": true
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#e7f0e2"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Newsletter card",
      "default": "#fbf7ef"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#27372b"
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "category": "t:categories.custom",
      "blocks": [
        {
          "type": "_sp-footer-menu",
          "settings": {
            "heading": "Shop"
          }
        },
        {
          "type": "_sp-footer-menu",
          "settings": {
            "heading": "Help"
          }
        },
        {
          "type": "_sp-footer-menu",
          "settings": {
            "heading": "About"
          }
        }
      ]
    }
  ]
}
{% endschema %}
