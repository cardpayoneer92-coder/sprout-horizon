{% comment %}
  Section contract.
  The product page, as the canvas drew it: breadcrumb, a round-cornered
  gallery with thumbnails, then the buy box — eyebrow, title, description,
  safety pills, price, the size finder, variants, a quantity stepper, add to
  bag, and accordion rows. Detail rows are child blocks.
  @example
  <!-- Chicken & pumpkin dinner · £18.00 per Small pack · Add to bag -->
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign p = product
  assign v = product.selected_or_first_available_variant
  assign badges = s.badges | newline_to_br | split: '<br />'
  assign sp_delivery_chips = s.delivery_chips | newline_to_br | split: '<br />'
  comment
    Detect which pet(s) this product is tagged for so we can show a mismatch
    notice when the saved profile is for a different pet.
  endcomment
  assign sp_product_pets = ''
  for tag in p.tags
    assign tl = tag | downcase
    if tl == 'dog' or tl == 'puppy' or tl == 'cat' or tl == 'small pet'
      if sp_product_pets == ''
        assign sp_product_pets = tl
      else
        assign sp_product_pets = sp_product_pets | append: ',' | append: tl
      endif
    endif
  endfor
-%}

{% render 'sp-pet-bar', show_bar: s.show_bar, bar_label: s.bar_label, bar_button: s.bar_button, bar_link: s.bar_link %}

<section class="sp-sec sp-pdp" style="--sp-sec-bg: {{ s.background }}; --sp-pdp-sticky-top: {{ s.sticky_top }}px; padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px;" data-product-pets="{{ sp_product_pets | escape }}">
  <div class="sp-wrap">

    {%- if s.show_breadcrumb -%}
      <nav class="sp-pdp__crumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span aria-hidden="true">/</span>
        {%- if collection -%}
          <a href="{{ collection.url }}">{{ collection.title }}</a>
          <span aria-hidden="true">/</span>
        {%- endif -%}
        <span>{{ p.title | default: 'Product' }}</span>
      </nav>
    {%- endif -%}

    <div class="sp-pdp__grid">

      <div class="sp-pdp__gallery sp-reveal">
        <div class="sp-pdp__stage">
          {%- if s.flag != blank -%}<span class="sp-pdp__flag">{{ s.flag | escape }}</span>{%- endif -%}
          <button type="button" class="sp-pdp__heart sp-heart" aria-label="Save this product">
            {% render 'sp-icon', name: 'heart', size: 20 %}
          </button>

          {%- if p.featured_media -%}
            <img
              class="sp-pdp__photo"
              id="sp-pdp-main-{{ section.id }}"
              src="{{ p.featured_media | image_url: width: 1200 }}"
              srcset="{{ p.featured_media | image_url: width: 600 }} 600w, {{ p.featured_media | image_url: width: 1200 }} 1200w"
              sizes="(min-width: 990px) 520px, 92vw"
              alt="{{ p.featured_media.alt | escape }}"
              width="{{ p.featured_media.width }}"
              height="{{ p.featured_media.height }}"
              loading="eager"
              fetchpriority="high"
            >
          {%- else -%}
            <span class="sp-pdp__art sp-bob">
              {% render 'sp-art', name: s.art, size: 320, label: p.title %}
            </span>
            {%- if p != blank -%}
              {%- assign shot = 'sp-' | append: p.handle | append: '-1.png' -%}
              <img class="sp-pdp__photo" data-sp-fallback src="{{ shot | asset_url }}" alt="{{ p.title | escape }}">
            {%- endif -%}
          {%- endif -%}
        </div>

        {%- if p.media.size > 1 -%}
          <div class="sp-pdp__thumbs">
            {%- for media in p.media limit: 6 -%}
              <button
                type="button"
                class="sp-pdp__thumb{% if forloop.first %} is-on{% endif %}"
                data-thumb
                data-full="{{ media | image_url: width: 1200 }}"
                aria-label="{{ media.alt | default: p.title | escape }}"
              >
                <img src="{{ media | image_url: width: 300 }}" alt="" width="150" height="150" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="sp-pdp__buy">
        {%- if s.show_mismatch -%}
          <div class="sp-pdp__mismatch" data-sp-mismatch
               data-template="{{ s.mismatch_text | escape }}"
               data-link="{{ s.mismatch_link | escape }}"
               hidden>
            {% render 'sp-icon', name: 'paw', size: 16 %}
            <span data-sp-mismatch-text></span>
          </div>
        {%- endif -%}

        {%- if s.eyebrow != blank -%}<p class="sp-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        <h1 class="sp-pdp__title">{{ p.title | default: 'Product name' }}</h1>

        {%- if s.summary != blank -%}
          <p class="sp-pdp__summary">{{ s.summary | escape }}</p>
        {%- elsif p.description != blank -%}
          <div class="sp-pdp__summary">{{ p.description | strip_html | truncatewords: 42 }}</div>
        {%- endif -%}

        {%- if s.badges != blank -%}
          <ul class="sp-safety" role="list">
            {%- for line in badges -%}
              {%- assign label = line | strip -%}
              {%- if label != blank -%}
                <li class="sp-safety__pill">{% render 'sp-icon', name: 'check', size: 16 %}{{ label }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if s.delivery_chips != blank -%}
          <div class="sp-pdp__delivery">
            {%- for chip in sp_delivery_chips -%}
              {%- assign dlabel = chip | strip -%}
              {%- if dlabel != blank -%}
                <span class="sp-pdp__delivery-chip">{{ dlabel }}</span>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        <p class="sp-pdp__price">
          {%- if v -%}
            <s data-compare{% unless v.compare_at_price > v.price %} hidden{% endunless %}>{{ v.compare_at_price | money }}</s>
            <span class="sp-pdp__amount" data-price>{{ v.price | money }}</span>
          {%- else -%}
            <span class="sp-pdp__amount">[PRICE]</span>
          {%- endif -%}
          {%- if s.price_note != blank -%}<span class="sp-pdp__note">{{ s.price_note | escape }}</span>{%- endif -%}
        </p>

        {%- if s.show_finder -%}
          {% render 'sp-finder-card',
            heading: s.finder_heading,
            text: s.finder_text,
            small_max: s.small_max,
            medium_max: s.medium_max,
            grams_per_kg: s.grams_per_kg,
            hide_chips: true %}
        {%- endif -%}

        {%- if p != blank -%}
          {%- assign sp_form_id = 'sp-pdp-form-' | append: section.id -%}
          <product-form-component
            data-section-id="{{ section.id }}"
            data-product-id="{{ p.id }}"
            data-product-url="{{ p.url }}"
            on:submit="/handleSubmit"
            data-quantity-default="1"
          >
          <div class="sp-visually-hidden" aria-live="assertive" role="status" aria-atomic="true"></div>
          {%- form 'product', p, class: 'sp-pdp__form', id: sp_form_id, 'data-type': 'add-to-cart-form' -%}
            {%- if p.has_only_default_variant == false -%}
              <div class="sp-pdp__options">
                {%- for option in p.options_with_values -%}
                  <fieldset class="sp-pdp__opt">
                    <legend>{{ option.name }}</legend>
                    <div class="sp-pdp__swatches">
                      {%- for value in option.values -%}
                        <label class="sp-pdp__swatch{% if option.selected_value == value %} is-on{% endif %}">
                          <input type="radio" name="sp-opt-{{ section.id }}-{{ option.position }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %} data-opt="{{ option.position }}">
                          <span>{{ value }}</span>
                        </label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
              </div>

              <script type="application/json" data-variants>
                [
                  {%- for variant in p.variants -%}
                    {
                      "id": {{ variant.id }},
                      "available": {{ variant.available }},
                      "price": {{ variant.price | json }},
                      "priceText": {{ variant.price | money | json }},
                      "compareText": {%- if variant.compare_at_price > variant.price -%}{{ variant.compare_at_price | money | json }}{%- else -%}null{%- endif -%},
                      "title": {{ variant.title | json }}
                    }{% unless forloop.last %},{% endunless %}
                  {%- endfor -%}
                ]
              </script>

              <select class="sp-visually-hidden" name="id" data-variant-select>
                {%- for variant in p.variants -%}
                  <option value="{{ variant.id }}" {% if variant == v %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                    {{ variant.title }}
                  </option>
                {%- endfor -%}
              </select>
            {%- else -%}
              <input type="hidden" name="id" value="{{ v.id }}">
            {%- endif -%}

            <div class="sp-pdp__actions">
              <div class="sp-qty">
                <button type="button" class="sp-qty__btn" data-qty="-1" aria-label="Decrease quantity">&minus;</button>
                <input class="sp-qty__input" type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="Quantity">
                <button type="button" class="sp-qty__btn" data-qty="1" aria-label="Increase quantity">+</button>
              </div>
              <button type="submit" class="sp-btn sp-btn--primary sp-pdp__add" data-label="{{ s.button_text | escape }}"{% unless p.available %} disabled{% endunless %}>
                {%- if p.available -%}{{ s.button_text | escape }}{%- else -%}{{ s.sold_out_text | escape }}{%- endif -%}
              </button>
            </div>
          {%- endform -%}
          </product-form-component>
        {%- else -%}
          <div class="sp-pdp__actions">
            <span class="sp-btn sp-btn--primary sp-pdp__add">{{ s.button_text | escape }}</span>
          </div>
        {%- endif -%}

        {%- if s.show_subscribe -%}
          <label class="sp-pdp__subscribe">
            <input type="checkbox" data-subscribe>
            <span class="sp-pdp__subscribe-label">{{ s.subscribe_text | escape }}</span>
            {%- if s.subscribe_note != blank -%}
              <span class="sp-pdp__subscribe-note">{{ s.subscribe_note | escape }}</span>
            {%- endif -%}
          </label>
        {%- endif -%}

        {%- if s.reassurance != blank -%}
          {%- assign sp_amount = settings.free_shipping_threshold | times: 100 | money -%}
          {%- assign reassurance_text = s.reassurance | replace: '[AMOUNT]', sp_amount -%}
          <p class="sp-pdp__reassure">
            {% render 'sp-icon', name: 'truck', size: 17 %}
            {{ reassurance_text | escape }}
          </p>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="sp-pdp__rows">{% content_for 'blocks' %}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script type="module">
  if (!customElements.get('sp-pdp')) {
    customElements.define('sp-pdp', class extends HTMLElement {});
  }

  (function () {
    const root = document.currentScript ? document.currentScript.parentNode : document;
    const scope = document.querySelector('.sp-pdp');
    if (!scope) return;

    // quantity stepper
    scope.querySelectorAll('[data-qty]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const field = scope.querySelector('.sp-qty__input');
        if (!field) return;
        const next = Math.max(1, (parseInt(field.value, 10) || 1) + Number(btn.dataset.qty));
        field.value = next;
      });
    });

    // thumbnails swap the main photo
    const main = scope.querySelector('.sp-pdp__photo');
    scope.querySelectorAll('[data-thumb]').forEach((thumb) => {
      thumb.addEventListener('click', () => {
        if (!main) return;
        main.src = thumb.dataset.full;
        main.removeAttribute('srcset');
        scope.querySelectorAll('[data-thumb]').forEach((t) => t.classList.remove('is-on'));
        thumb.classList.add('is-on');
      });
    });

    // option pills drive the hidden variant select
    const select = scope.querySelector('[data-variant-select]');
    if (select) {
      const pick = () => {
        const chosen = [...scope.querySelectorAll('[data-opt]:checked')].map((i) => i.value);
        const match = [...select.options].find((o) =>
          chosen.every((val) => o.textContent.split(' / ').map((s) => s.trim()).includes(val))
        );
        if (match) {
          select.value = match.value;
          select.dispatchEvent(new Event('change', { bubbles: true }));
        }
      };
      let variants = [];
      const data = scope.querySelector('[data-variants]');
      if (data) { try { variants = JSON.parse(data.textContent); } catch (e) { variants = []; } }

      // The price is rendered for the first variant, so it has to follow the
      // choice — otherwise a shopper picks Large and still reads Small's price.
      const paint = () => {
        const chosen = variants.find((variant) => String(variant.id) === String(select.value));
        if (!chosen) return;

        const price = scope.querySelector('[data-price]');
        const compare = scope.querySelector('[data-compare]');
        if (price) price.textContent = chosen.priceText;
        if (compare) {
          compare.hidden = !chosen.compareText;
          if (chosen.compareText) compare.textContent = chosen.compareText;
        }

        const add = scope.querySelector('.sp-pdp__add');
        if (add) {
          add.disabled = !chosen.available;
          add.textContent = chosen.available ? add.dataset.label : 'Sold out';
        }

        document.dispatchEvent(new CustomEvent('sprout:variant-change', { detail: chosen }));
      };

      scope.querySelectorAll('[data-opt]').forEach((input) => {
        input.addEventListener('change', () => {
          const group = input.closest('.sp-pdp__swatches');
          group.querySelectorAll('.sp-pdp__swatch').forEach((l) => l.classList.remove('is-on'));
          input.closest('.sp-pdp__swatch').classList.add('is-on');
          pick();
          paint();
        });
      });
      paint();

      // Pet mismatch notice — shown when saved pet ≠ product's tagged pet.
      (function () {
        const notice = scope.querySelector('[data-sp-mismatch]');
        if (!notice) return;
        const rawPets = (scope.dataset.productPets || '').split(',').map((s) => s.trim()).filter(Boolean);
        if (!rawPets.length) return; // universal product — no mismatch possible

        function checkMismatch(profile) {
          if (!profile || !profile.pet) { notice.hidden = true; return; }
          const saved = profile.pet.toLowerCase();
          if (rawPets.includes(saved)) { notice.hidden = true; return; }

          // Build notice text — replace [product_pet] and [pet] tokens.
          const productPet = rawPets[0];
          const tmpl = notice.dataset.template || 'This one is for [product_pet]s — see [pet] picks →';
          const text = tmpl.replace('[product_pet]', productPet).replace('[pet]', saved);
          const textNode = notice.querySelector('[data-sp-mismatch-text]');
          if (textNode) textNode.textContent = text;

          // Build the link href if a link template was provided.
          const linkTmpl = notice.dataset.link || '';
          if (linkTmpl) {
            const href = linkTmpl.replace('[pet]', saved).replace('[product_pet]', productPet);
            let anchor = notice.querySelector('a');
            if (!anchor) {
              anchor = document.createElement('a');
              notice.appendChild(anchor);
            }
            anchor.href = href;
            anchor.textContent = '→';
          }
          notice.hidden = false;
        }

        try { checkMismatch(JSON.parse(localStorage.getItem('sprout:pet'))); } catch (e) {}
        document.addEventListener('sprout:pet-change', (e) => checkMismatch(e.detail));
      })();

      // When the size finder recommends a size, pre-select the matching variant.
      document.addEventListener('sprout:size-suggest', (e) => {
        const size = e.detail && e.detail.size;
        if (!size) return;
        // Find a [data-opt] radio whose value matches the suggested size (case-insensitive).
        const target = [...scope.querySelectorAll('[data-opt]')].find(
          (i) => i.value.toLowerCase() === size.toLowerCase()
        );
        if (target && !target.checked) {
          target.checked = true;
          target.dispatchEvent(new Event('change', { bubbles: true }));
        }
      });
    }
  })();
</script>

{% stylesheet %}
  .sp-pdp__crumb { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 22px; font-size: 14px; color: var(--sp-muted, #566358); }
  .sp-pdp__crumb a { color: inherit; text-decoration: none; }
  .sp-pdp__crumb a:hover { color: var(--sp-moss, #2f7a46); }

  /* Improvements 13/14/18: mismatch notice, sticky gallery, delivery & subscribe */
  .sp-pdp__mismatch { display: flex; align-items: center; gap: 8px; margin-bottom: 16px; padding: 12px 16px; border-radius: 999px; background: var(--sp-peach, #f3c3a0); font-size: 14px; font-weight: 700; color: var(--sp-ink, #27372b); }
  .sp-pdp__mismatch svg { flex-shrink: 0; }
  .sp-pdp__mismatch a { color: inherit; }

  .sp-pdp__delivery { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }
  .sp-pdp__delivery-chip { display: inline-flex; align-items: center; padding: 7px 14px; border-radius: 999px; background: var(--sp-cream, #fdfaf2); border: 1.5px solid var(--sp-line-mint, #d6e2d0); font-size: 13px; font-weight: 700; color: var(--sp-ink, #27372b); }

  .sp-pdp__subscribe { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin: 0 0 16px; padding: 14px 18px; border-radius: var(--sp-r-tile, 22px); background: var(--sp-mint, #d8edcd); cursor: pointer; }
  .sp-pdp__subscribe input[type=checkbox] { width: 20px; height: 20px; accent-color: var(--sp-moss, #3f6b4a); flex-shrink: 0; }
  .sp-pdp__subscribe-label { font-weight: 700; font-size: 15px; }
  .sp-pdp__subscribe-note { width: 100%; margin-left: 32px; font-size: 13px; color: var(--sp-muted, #566358); }

  /* Improvement 14: gallery column is sticky so it stays in view while the tall buy-box scrolls */
  .sp-pdp__gallery { position: sticky; top: var(--sp-pdp-sticky-top, 80px); align-self: start; }

  .sp-pdp__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 4.5vw, 56px); align-items: start; }

  /* gallery */
  .sp-pdp__stage { position: relative; aspect-ratio: 1 / 1; border-radius: var(--sp-r-hero, 44px); background: var(--sp-mint, #d8edcd); display: grid; place-items: center; overflow: hidden; }
  .sp-pdp__photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .sp-pdp__art .sp-art { width: 62%; height: auto; max-width: none; }
  .sp-pdp__flag { position: absolute; z-index: 3; top: 20px; left: 20px; padding: 8px 15px; border-radius: 999px; background: var(--sp-cream, #fdfaf2); font-size: 13px; font-weight: 700; }
  .sp-pdp__heart { position: absolute; z-index: 3; top: 18px; right: 18px; display: grid; place-items: center; width: 46px; height: 46px; border: 0; border-radius: 999px; background: var(--sp-cream, #fdfaf2); color: var(--sp-ink, #27372b); cursor: pointer; }

  .sp-pdp__thumbs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-top: 14px; }
  .sp-pdp__thumb { aspect-ratio: 1 / 1; padding: 0; border: 3px solid transparent; border-radius: var(--sp-r-tile, 22px); background: var(--sp-sand, #fbe9d2); overflow: hidden; cursor: pointer; transition: border-color 0.2s ease, transform 0.26s var(--sp-ease-back); }
  .sp-pdp__thumb:hover { transform: translateY(-3px); }
  .sp-pdp__thumb.is-on { border-color: var(--sp-moss, #2f7a46); }
  .sp-pdp__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* buy box */
  .sp-pdp__title { margin: 0 0 14px; font-family: var(--sp-font-head); font-size: clamp(32px, 3.6vw, 46px); font-weight: 500; line-height: 1.06; letter-spacing: -0.02em; }
  .sp-pdp__summary { margin: 0 0 22px; font-size: 18px; line-height: 1.55; color: var(--sp-muted, #566358); }

  .sp-safety { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 24px; padding: 0; list-style: none; }
  .sp-safety__pill { display: inline-flex; align-items: center; gap: 7px; padding: 8px 15px; border-radius: 999px; background: var(--sp-mint, #d8edcd); font-size: 13px; font-weight: 700; }
  .sp-safety__pill svg { color: var(--sp-moss, #2f7a46); }

  .sp-pdp__price { display: flex; align-items: baseline; flex-wrap: wrap; gap: 12px; margin: 0 0 22px; }
  .sp-pdp__amount { font-family: var(--sp-font-head); font-size: 32px; font-weight: 500; }
  .sp-pdp__price s { color: var(--sp-muted, #566358); }
  .sp-pdp__note { font-size: 15px; color: var(--sp-muted, #566358); }

  .sp-pdp__form { margin: 0; }
  .sp-pdp__options { display: grid; gap: 16px; margin-bottom: 22px; }
  .sp-pdp__opt { border: 0; padding: 0; margin: 0; }
  .sp-pdp__opt legend { padding: 0; margin-bottom: 9px; font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--sp-muted, #566358); }
  .sp-pdp__swatches { display: flex; flex-wrap: wrap; gap: 8px; }
  .sp-pdp__swatch { position: relative; }
  .sp-pdp__swatch input { position: absolute; opacity: 0; width: 0; height: 0; }
  .sp-pdp__swatch span { display: inline-flex; align-items: center; min-height: 46px; padding: 0 20px; border-radius: 999px; border: 2px solid var(--sp-line-mint, #d6e2d0); background: var(--sp-cream, #fdfaf2); font-weight: 700; font-size: 15px; cursor: pointer; transition: background-color 0.2s ease, border-color 0.2s ease; }
  .sp-pdp__swatch.is-on span { background: var(--sp-moss, #2f7a46); border-color: var(--sp-moss, #2f7a46); color: var(--sp-cream, #fdfaf2); }
  .sp-pdp__swatch input:focus-visible + span { outline: 3px solid var(--sp-moss, #2f7a46); outline-offset: 2px; }

  .sp-pdp__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 16px; }
  .sp-qty { display: flex; align-items: center; border: 2px solid var(--sp-line-mint, #d6e2d0); border-radius: 999px; background: var(--sp-cream, #fdfaf2); }
  .sp-qty__btn { width: 46px; height: 52px; border: 0; background: transparent; font-family: inherit; font-size: 20px; color: inherit; cursor: pointer; }
  .sp-qty__input { width: 46px; min-height: 52px; border: 0; background: transparent; font-family: inherit; font-size: 16px; font-weight: 700; text-align: center; color: inherit; -moz-appearance: textfield; }
  .sp-qty__input::-webkit-outer-spin-button, .sp-qty__input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .sp-pdp__add { flex: 1 1 220px; min-height: 56px; font-size: 17px; }
  .sp-pdp__add[disabled] { opacity: 0.55; cursor: not-allowed; }

  .sp-pdp__reassure { display: flex; align-items: center; gap: 8px; margin: 0 0 26px; font-size: 14px; color: var(--sp-muted, #566358); }
  .sp-pdp__reassure svg { color: var(--sp-moss, #2f7a46); }
  .sp-pdp__rows { border-top: 1px solid var(--sp-line, #e3dccd); }

  @media (max-width: 989px) {
    .sp-pdp__grid { grid-template-columns: minmax(0, 1fr); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "class": "sp-product-section",
  "enabled_on": { "templates": ["product"] },
  "blocks": [{ "type": "_sp-pd-row" }],
  "settings": [
    { "type": "header", "content": "Pet bar" },
    { "type": "checkbox", "id": "show_bar", "label": "Show the pet bar", "default": true },
    { "type": "text", "id": "bar_label", "label": "Bar label", "default": "Shopping for" },
    { "type": "text", "id": "bar_button", "label": "Bar button", "default": "Change pet" },
    { "type": "url", "id": "bar_link", "label": "Bar link" },
    { "type": "header", "content": "Pet mismatch notice" },
    { "type": "paragraph", "content": "Shows when the saved pet doesn't match this product's tags (dog, cat, puppy, small pet). Hide the notice or change the wording here." },
    { "type": "checkbox", "id": "show_mismatch", "label": "Show mismatch notice", "default": true },
    { "type": "text", "id": "mismatch_text", "label": "Notice text", "default": "This one is for [product_pet]s — see [pet] picks →", "info": "[product_pet] = this product's pet. [pet] = the saved pet." },
    { "type": "text", "id": "mismatch_link", "label": "Notice link", "default": "/collections/[pet]", "info": "[pet] is replaced with the saved pet name, e.g. /collections/cat" },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Gently cooked · adult dog" },
    { "type": "textarea", "id": "summary", "label": "Summary", "info": "Leave empty to use the start of the product description." },
    { "type": "textarea", "id": "badges", "label": "Safety pills", "default": "Vet approved\nNon-toxic\nNo fillers\nCompostable pack", "info": "One per line." },
    { "type": "text", "id": "price_note", "label": "Price note", "default": "per pack" },
    { "type": "text", "id": "button_text", "label": "Button", "default": "Add to bag" },
    { "type": "text", "id": "sold_out_text", "label": "Sold out label", "default": "Sold out" },
    { "type": "text", "id": "reassurance", "label": "Reassurance", "default": "Free delivery over [AMOUNT] · skip or cancel any time" },
    { "type": "textarea", "id": "delivery_chips", "label": "Delivery info chips", "default": "48 hrs\nPosted chilled\nCooked this week", "info": "One chip per line. Leave empty to hide." },
    { "type": "header", "content": "Subscribe & save" },
    { "type": "paragraph", "content": "Shows a checkbox toggle in the buy box. Wire up Shopify Selling Plans so the discount actually applies at checkout." },
    { "type": "checkbox", "id": "show_subscribe", "label": "Show subscribe toggle", "default": false },
    { "type": "text", "id": "subscribe_text", "label": "Toggle label", "default": "Subscribe and save" },
    { "type": "text", "id": "subscribe_note", "label": "Note below toggle", "default": "10% off every order · skip or cancel any time" },
    { "type": "header", "content": "Gallery" },
    { "type": "text", "id": "flag", "label": "Corner flag", "default": "New recipe" },
    {
      "type": "select", "id": "art", "label": "Stand-in illustration", "default": "pouch",
      "options": [
        { "value": "pouch", "label": "Pouch" },
        { "value": "tin", "label": "Tin" },
        { "value": "jar", "label": "Jar" },
        { "value": "bowl", "label": "Bowl" },
        { "value": "bed", "label": "Bed" },
        { "value": "bone", "label": "Bone" },
        { "value": "blanket", "label": "Blanket" }
      ]
    },
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Breadcrumb", "default": true },
    { "type": "header", "content": "Size finder" },
    { "type": "checkbox", "id": "show_finder", "label": "Show the size finder", "default": true },
    { "type": "text", "id": "finder_heading", "label": "Heading", "default": "Which size does my pet need?" },
    { "type": "text", "id": "finder_text", "label": "Text", "default": "Pop in their weight and we will work out the portion." },
    { "type": "range", "id": "small_max", "label": "Small up to", "min": 2, "max": 20, "step": 1, "unit": "kg", "default": 10 },
    { "type": "range", "id": "medium_max", "label": "Medium up to", "min": 10, "max": 50, "step": 1, "unit": "kg", "default": 25 },
    { "type": "range", "id": "grams_per_kg", "label": "Grams per kg a day", "min": 10, "max": 40, "step": 1, "default": 22 },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "background", "label": "Background", "default": "#fdfaf2" },
    { "type": "range", "id": "sticky_top", "label": "Gallery sticky offset", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80, "info": "Space from the top of the viewport where the image column sticks. Increase if your header is taller than 80 px." },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 48 }
  ]
}
{% endschema %}
