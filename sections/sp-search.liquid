{% comment %}
  Section contract.
  Search results: a big rounded search field, a count, then the same product
  cards the rest of the shop uses, with articles and pages listed after.
  @example
  <!-- 7 results for "salmon" -->
{% endcomment %}

{%- liquid
  assign s = section.settings
-%}

{% render 'sp-pet-bar', show_bar: s.show_bar, bar_label: s.bar_label, bar_button: s.bar_button, bar_link: s.bar_link %}

<section class="sp-sec sp-search" style="--sp-sec-bg: {{ s.background }}; --sp-search-cols: {{ s.columns }}; padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px;">
  <div class="sp-wrap">
    <div class="sp-search__head sp-reveal">
      <h1 class="sp-h2">{{ s.heading | escape }}</h1>
      <form class="sp-search__form" action="{{ routes.search_url }}" method="get" role="search">
        <label class="sp-visually-hidden" for="sp-search-{{ section.id }}">{{ settings.sp_t_search | escape }}</label>
        {% render 'sp-icon', name: 'search', size: 20 %}
        <input id="sp-search-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ s.placeholder | escape }}">
        <button type="submit" class="sp-btn sp-btn--primary sp-btn--sm">{{ settings.sp_t_search | escape }}</button>
      </form>
    </div>

    {%- if search.performed -%}
      {%- assign safe_terms = search.terms | escape -%}
      <p class="sp-search__count">
        {%- if search.results_count == 0 -%}
          {%- assign terms_html = '<strong>' | append: safe_terms | append: '</strong>' -%}
          {{ s.none_text | escape | replace: '[TERMS]', terms_html }}
        {%- else -%}
          {%- assign terms_html = '<strong>' | append: safe_terms | append: '</strong>' -%}
          {%- assign count_html = '<strong>' | append: search.results_count | append: '</strong>' -%}
          {%- if search.results_count == 1 -%}{%- assign line = s.count_one -%}{%- else -%}{%- assign line = s.count_many -%}{%- endif -%}
          {{ line | escape | replace: '[COUNT]', count_html | replace: '[TERMS]', terms_html }}
        {%- endif -%}
      </p>

      {%- if search.results_count == 0 -%}
        <div class="sp-search__empty sp-reveal">
          <span class="sp-bob">{% render 'sp-art', name: 'cat', size: 190, label: 'A cat that found nothing' %}</span>
          <h2 class="sp-h3">{{ s.empty_heading | escape }}</h2>
          <p>{{ s.empty_text | escape }}</p>
          <a class="sp-btn sp-btn--primary" href="{{ s.empty_link | default: '/collections/all' }}">{{ s.empty_button | escape }}</a>
        </div>
      {%- else -%}
        {% paginate search.results by s.results_per_page %}
          <div class="sp-grid sp-search__grid">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'sp-product-card', product: item, index: forloop.index0, show_quick_add: true %}
              {%- else -%}
                <a class="sp-search__page" href="{{ item.url }}">
                  <span class="sp-search__kind">{% if item.object_type == 'article' %}{{ s.kind_article | escape }}{% else %}{{ s.kind_page | escape }}{% endif %}</span>
                  <h2 class="sp-search__name">{{ item.title }}</h2>
                  <p class="sp-search__excerpt">{{ item.content | strip_html | truncatewords: 26 }}</p>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {% render 'sp-pager', paginate: paginate %}
        {% endpaginate %}
      {%- endif -%}
    {%- else -%}
      <div class="sp-search__empty sp-reveal">
        <span class="sp-bob">{% render 'sp-art', name: 'duo', size: 200, label: 'A dog and a cat waiting' %}</span>
        <h2 class="sp-h3">{{ s.idle_heading | escape }}</h2>
        <p>{{ s.idle_text | escape }}</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .sp-search__head { display: grid; gap: 18px; margin-bottom: 22px; }
  .sp-search__form { display: flex; align-items: center; gap: 10px; padding: 8px 8px 8px 20px; border: 2px solid var(--sp-line-mint, #d6e2d0); border-radius: 999px; background: var(--sp-cream, #fdfaf2); max-width: 640px; }
  .sp-search__form > svg { flex: 0 0 auto; color: var(--sp-moss, #2f7a46); }
  .sp-search__form input { flex: 1 1 auto; min-width: 0; min-height: 44px; border: 0; background: transparent; font-family: inherit; font-size: 17px; color: inherit; }
  .sp-search__form input:focus { outline: none; }

  .sp-search__count { margin: 0 0 24px; font-size: 16px; color: var(--sp-muted, #566358); }
  .sp-search__grid { grid-template-columns: repeat(var(--sp-search-cols, 4), minmax(0, 1fr)); }

  .sp-search__page { display: grid; align-content: start; gap: 6px; padding: 22px; border-radius: var(--sp-r-card, 28px); background: var(--sp-mint, #d8edcd); color: inherit; text-decoration: none; transition: transform 0.26s var(--sp-ease-back); }
  .sp-search__page:hover { transform: translateY(-5px) rotate(-1deg); }
  .sp-search__kind { font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--sp-moss, #2f7a46); }
  .sp-search__name { margin: 0; font-family: var(--sp-font-head); font-size: 21px; font-weight: 500; }
  .sp-search__excerpt { margin: 0; font-size: 14px; color: var(--sp-muted, #566358); }

  .sp-search__empty { display: grid; justify-items: center; gap: 10px; text-align: center; padding: 52px 24px 60px; border-radius: var(--sp-r-hero, 44px); background: var(--sp-mint, #d8edcd); }
  .sp-search__empty .sp-art { width: 170px; height: auto; max-width: none; }
  .sp-search__empty p { margin: 0 0 10px; color: var(--sp-muted, #566358); max-width: 40ch; }


  @media (max-width: 989px) { .sp-search__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
{% endstylesheet %}

{% schema %}
{
  "name": "Search",
  "tag": "section",
  "class": "sp-search-section",
  "enabled_on": { "templates": ["search"] },
  "settings": [
    { "type": "header", "content": "Pet bar" },
    { "type": "checkbox", "id": "show_bar", "label": "Show the pet bar", "default": true },
    { "type": "text", "id": "bar_label", "label": "Bar label", "default": "Shopping for" },
    { "type": "text", "id": "bar_button", "label": "Bar button", "default": "Change pet" },
    { "type": "url", "id": "bar_link", "label": "Bar link" },
    { "type": "header", "content": "Search" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Search" },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Try \"salmon\" or \"slow bowl\"" },
    { "type": "range", "id": "columns", "label": "Columns", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "text", "id": "none_text", "label": "No results line", "default": "Nothing matched [TERMS].", "info": "[TERMS] is what the shopper typed." },
    { "type": "text", "id": "count_one", "label": "One result", "default": "[COUNT] result for [TERMS]" },
    { "type": "text", "id": "count_many", "label": "Several results", "default": "[COUNT] results for [TERMS]" },
    { "type": "text", "id": "kind_article", "label": "Tag on blog posts", "default": "Journal" },
    { "type": "text", "id": "kind_page", "label": "Tag on pages", "default": "Page" },
    { "type": "range", "id": "results_per_page", "label": "Results per page", "min": 8, "max": 48, "step": 4, "default": 16 },
    { "type": "header", "content": "Before searching" },
    { "type": "text", "id": "idle_heading", "label": "Heading", "default": "What are we looking for?" },
    { "type": "text", "id": "idle_text", "label": "Text", "default": "Type a food, a treat or a thing to sleep on." },
    { "type": "header", "content": "Nothing found" },
    { "type": "text", "id": "empty_heading", "label": "Heading", "default": "Nothing under that rock" },
    { "type": "text", "id": "empty_text", "label": "Text", "default": "Try a shorter word, or have a browse instead." },
    { "type": "text", "id": "empty_button", "label": "Button", "default": "Browse everything" },
    { "type": "url", "id": "empty_link", "label": "Button link" },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "background", "label": "Background", "default": "#fdfaf2" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 64 }
  ]
}
{% endschema %}
