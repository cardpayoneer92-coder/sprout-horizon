{% comment %}
  Section contract.
  The cart page: a free-shipping meter that fills as the total climbs, the
  lines with quantity steppers, and a summary that sticks beside them. An
  empty cart gets an illustration and a way back to the shop.
  @example
  <!-- £24 to go for free delivery · 2 items · Checkout -->
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign goal = s.free_shipping_goal | times: 100
  assign left = goal | minus: cart.total_price
  assign pct = 0
  if goal > 0
    assign pct = cart.total_price | times: 100 | divided_by: goal
    if pct > 100
      assign pct = 100
    endif
  endif
-%}

<section class="sp-sec sp-cart" style="--sp-sec-bg: {{ s.background }}; padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px;">
  <div class="sp-wrap">
    <h1 class="sp-h2 sp-cart__title">{{ s.heading | escape }}</h1>

    {%- if cart.item_count == 0 -%}
      <div class="sp-cart__empty sp-reveal">
        <span class="sp-bob">{% render 'sp-art', name: 'bowl', size: 200, label: 'An empty bowl' %}</span>
        <h2 class="sp-h3">{{ s.empty_heading | escape }}</h2>
        <p>{{ s.empty_text | escape }}</p>
        <a class="sp-btn sp-btn--primary" href="{{ s.empty_link | default: '/collections/all' }}">{{ s.empty_button | escape }}</a>
      </div>
    {%- else -%}

      {%- if s.show_meter and goal > 0 -%}
        <div class="sp-meter sp-reveal">
          <p class="sp-meter__line">
            {% render 'sp-icon', name: 'truck', size: 18 %}
            {%- if left > 0 -%}
              <span><strong>{{ left | money }}</strong> to go for free delivery</span>
            {%- else -%}
              <span><strong>Free delivery unlocked</strong> — nice one.</span>
            {%- endif -%}
          </p>
          <span class="sp-meter__track"><span class="sp-meter__fill" style="width: {{ pct }}%;"></span></span>
        </div>
      {%- endif -%}

      <form action="{{ routes.cart_url }}" method="post" novalidate class="sp-cart__grid">
        <div class="sp-cart__lines">
          {%- for line in cart.items -%}
            <div class="sp-cart__line sp-reveal">
              <a class="sp-cart__thumb" href="{{ line.url }}">
                {%- if line.image -%}
                  <img src="{{ line.image | image_url: width: 220 }}" alt="{{ line.title | escape }}" width="110" height="110" loading="lazy">
                {%- else -%}
                  {%- assign shot = 'sp-' | append: line.product.handle | append: '-1.png' -%}
                  <img data-sp-fallback src="{{ shot | asset_url }}" alt="{{ line.title | escape }}" width="110" height="110" loading="lazy">
                  {% render 'sp-art', name: 'pouch', size: 70 %}
                {%- endif -%}
              </a>

              <div class="sp-cart__copy">
                <h2 class="sp-cart__name"><a href="{{ line.url }}">{{ line.product.title }}</a></h2>
                {%- unless line.product.has_only_default_variant -%}
                  <p class="sp-cart__variant">{{ line.variant.title }}</p>
                {%- endunless -%}
                <p class="sp-cart__each">{{ line.original_price | money }} each</p>
              </div>

              <div class="sp-cart__qty">
                <a class="sp-qty__btn" href="{{ line.url_to_remove }}" aria-label="Remove {{ line.title | escape }}">&minus;</a>
                <input class="sp-qty__input" type="number" name="updates[]" value="{{ line.quantity }}" min="0" inputmode="numeric" aria-label="Quantity for {{ line.title | escape }}">
                <a class="sp-qty__btn" href="{{ line.url_to_add | default: line.url }}" aria-label="Add one more {{ line.title | escape }}">+</a>
              </div>

              <span class="sp-cart__total">{{ line.final_line_price | money }}</span>
            </div>
          {%- endfor -%}

          <button type="submit" name="update" class="sp-btn sp-btn--soft sp-btn--sm sp-cart__update">Update quantities</button>
        </div>

        <aside class="sp-cart__summary sp-reveal">
          <h2 class="sp-h3">Summary</h2>
          <p class="sp-cart__row"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></p>
          <p class="sp-cart__row sp-cart__row--muted"><span>Delivery</span><span>{% if left > 0 %}Worked out at checkout{% else %}Free{% endif %}</span></p>

          {%- if s.show_note -%}
            <label class="sp-cart__note">
              <span>{{ s.note_label | escape }}</span>
              <textarea name="note" rows="3" placeholder="{{ s.note_placeholder | escape }}">{{ cart.note }}</textarea>
            </label>
          {%- endif -%}

          <button type="submit" name="checkout" class="sp-btn sp-btn--primary sp-cart__checkout">{{ s.checkout_text | escape }}</button>
          <p class="sp-cart__fine">{{ s.fine_print | escape }}</p>
        </aside>
      </form>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .sp-cart__title { margin: 0 0 24px; }

  .sp-cart__empty { display: grid; justify-items: center; gap: 10px; text-align: center; padding: 56px 24px 64px; border-radius: var(--sp-r-hero, 44px); background: var(--sp-mint, #d8edcd); }
  .sp-cart__empty .sp-art { width: 160px; height: auto; max-width: none; }
  .sp-cart__empty p { margin: 0 0 10px; color: var(--sp-muted, #566358); max-width: 36ch; }

  .sp-meter { padding: 16px 22px; margin-bottom: 24px; border-radius: var(--sp-r-card, 28px); background: var(--sp-mint, #d8edcd); }
  .sp-meter__line { display: flex; align-items: center; gap: 9px; margin: 0 0 10px; font-size: 15px; }
  .sp-meter__line svg { color: var(--sp-moss, #2f7a46); }
  .sp-meter__track { display: block; height: 10px; border-radius: 999px; background: var(--sp-cream, #fdfaf2); overflow: hidden; }
  .sp-meter__fill { display: block; height: 100%; border-radius: 999px; background: linear-gradient(90deg, var(--sp-leaf, #6cb359), var(--sp-moss, #2f7a46)); transition: width 0.5s var(--sp-ease); }

  .sp-cart__grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 28px; align-items: start; }
  .sp-cart__lines { display: grid; gap: 14px; }
  .sp-cart__line { display: grid; grid-template-columns: 96px minmax(0, 1fr) auto auto; align-items: center; gap: 16px; padding: 16px; border-radius: var(--sp-r-card, 28px); background: var(--sp-cream, #fdfaf2); border: 1px solid var(--sp-line, #e3dccd); }
  .sp-cart__thumb { position: relative; display: grid; place-items: center; width: 96px; height: 96px; border-radius: var(--sp-r-tile, 22px); background: var(--sp-mint, #d8edcd); overflow: hidden; }
  .sp-cart__thumb img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .sp-cart__name { margin: 0; font-size: 16px; font-weight: 700; }
  .sp-cart__name a { color: inherit; text-decoration: none; }
  .sp-cart__variant, .sp-cart__each { margin: 2px 0 0; font-size: 14px; color: var(--sp-muted, #566358); }
  .sp-cart__qty { display: flex; align-items: center; border: 2px solid var(--sp-line-mint, #d6e2d0); border-radius: 999px; }
  .sp-cart__qty .sp-qty__btn { display: grid; place-items: center; width: 40px; height: 44px; text-decoration: none; color: inherit; }
  .sp-cart__total { font-weight: 700; font-size: 16px; }
  .sp-cart__update { justify-self: start; }

  .sp-cart__summary { position: sticky; top: 96px; padding: 24px; border-radius: var(--sp-r-card, 28px); background: var(--sp-mint, #d8edcd); }
  .sp-cart__row { display: flex; justify-content: space-between; gap: 16px; margin: 14px 0 0; font-size: 16px; }
  .sp-cart__row--muted { color: var(--sp-muted, #566358); font-size: 14px; }
  .sp-cart__note { display: block; margin: 18px 0 0; font-size: 13px; font-weight: 700; }
  .sp-cart__note textarea { width: 100%; margin-top: 6px; padding: 12px 16px; border: 2px solid #c9dac2; border-radius: 20px; background: var(--sp-cream, #fdfaf2); font-family: inherit; font-size: 15px; font-weight: 400; color: inherit; box-sizing: border-box; resize: vertical; }
  .sp-cart__checkout { width: 100%; margin-top: 18px; }
  .sp-cart__fine { margin: 12px 0 0; font-size: 13px; text-align: center; color: var(--sp-muted, #566358); }

  @media (max-width: 989px) {
    .sp-cart__grid { grid-template-columns: minmax(0, 1fr); }
    .sp-cart__summary { position: static; }
  }
  @media (max-width: 749px) {
    .sp-cart__line { grid-template-columns: 72px minmax(0, 1fr); }
    .sp-cart__thumb { width: 72px; height: 72px; }
    .sp-cart__qty, .sp-cart__total { grid-column: 2; justify-self: start; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "class": "sp-cart-section",
  "enabled_on": { "templates": ["cart"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your bag" },
    { "type": "text", "id": "checkout_text", "label": "Checkout button", "default": "Checkout" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "Taxes and delivery worked out at checkout." },
    { "type": "header", "content": "Free delivery meter" },
    { "type": "checkbox", "id": "show_meter", "label": "Show the meter", "default": true },
    { "type": "range", "id": "free_shipping_goal", "label": "Free delivery over", "min": 0, "max": 200, "step": 5, "default": 40 },
    { "type": "header", "content": "Note" },
    { "type": "checkbox", "id": "show_note", "label": "Ask for a note", "default": true },
    { "type": "text", "id": "note_label", "label": "Note label", "default": "Anything we should know?" },
    { "type": "text", "id": "note_placeholder", "label": "Note placeholder", "default": "Leave it with next door, please" },
    { "type": "header", "content": "Empty bag" },
    { "type": "text", "id": "empty_heading", "label": "Heading", "default": "An empty bowl" },
    { "type": "text", "id": "empty_text", "label": "Text", "default": "Nothing in the bag yet. Let us find something they will like." },
    { "type": "text", "id": "empty_button", "label": "Button", "default": "Start shopping" },
    { "type": "url", "id": "empty_link", "label": "Button link" },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "background", "label": "Background", "default": "#fdfaf2" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 64 }
  ]
}
{% endschema %}
