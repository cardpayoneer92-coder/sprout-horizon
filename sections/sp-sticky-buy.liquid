{% comment %}
  Section contract.
  A slim buy bar that slides down once the main add-to-bag has scrolled out
  of view: the product in miniature, its price and a second add button.
  @example
  <!-- Chicken & pumpkin dinner · £18.00 · Add to bag -->
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign p = product
  assign v = product.selected_or_first_available_variant
-%}

{%- if p != blank -%}
  <sp-sticky-buy class="sp-sticky" hidden style="--sp-sticky-bg: {{ s.background }};">
    <div class="sp-wrap sp-sticky__bar">
      <span class="sp-sticky__thumb">
        {%- if p.featured_media -%}
          <img src="{{ p.featured_media | image_url: width: 120 }}" alt="{{ p.featured_media.alt | default: p.title | escape }}" width="60" height="60" loading="lazy">
        {%- else -%}
          {% render 'sp-icon', name: 'bag', size: 22 %}
        {%- endif -%}
      </span>

      <span class="sp-sticky__copy">
        <strong>{{ p.title }}</strong>
        {%- if v and p.has_only_default_variant == false -%}
          <span>{{ v.title }}</span>
        {%- endif -%}
      </span>

      <span class="sp-sticky__price" data-sticky-price>{{ v.price | money }}</span>

      {%- form 'product', p, class: 'sp-sticky__form', id: null -%}
        <input type="hidden" name="id" value="{{ v.id }}" data-sticky-id>
        <input type="hidden" name="quantity" value="1" data-sticky-qty>
        <button type="submit" class="sp-btn sp-btn--primary sp-btn--sm" data-sticky-btn data-label="{{ s.button_text | escape }}" data-sold-out="{{ settings.sp_t_sold_out | escape }}" data-unavailable="{{ settings.sp_t_unavailable | escape }}"{% unless v.available %} disabled{% endunless %}>
          {%- if v.available -%}{{ s.button_text | escape }}{%- else -%}{{ settings.sp_t_sold_out | escape }}{%- endif -%}
        </button>
      {%- endform -%}
    </div>
  </sp-sticky-buy>

  <script type="module">
    if (!customElements.get('sp-sticky-buy')) {
      customElements.define('sp-sticky-buy', class extends HTMLElement {
        connectedCallback() {
          this.btn = this.querySelector('[data-sticky-btn]');
          // follow whatever the buy box has selected — price, variant,
          // availability — so the bar never adds something the box would not
          this.onVariant = (e) => {
            const d = e.detail || {};
            const price = this.querySelector('[data-sticky-price]');
            const id = this.querySelector('[data-sticky-id]');
            if (price && d.priceText) price.textContent = d.priceText;
            if (id && d.id) id.value = d.id;
            const sub = this.querySelector('.sp-sticky__copy span');
            if (sub && d.title) sub.textContent = d.title;
            if (this.btn) {
              this.btn.disabled = !d.available;
              this.btn.textContent = d.available ? this.btn.dataset.label
                : (d.unavailable ? this.btn.dataset.unavailable : this.btn.dataset.soldOut);
            }
          };
          document.addEventListener('sprout:variant-change', this.onVariant);

          // carry the buy box's quantity across
          this.onQty = (e) => {
            if (!e.target.matches || !e.target.matches('.sp-pdp .sp-qty__input')) return;
            const q = this.querySelector('[data-sticky-qty]');
            if (q) q.value = Math.max(1, parseInt(e.target.value, 10) || 1);
          };
          document.addEventListener('change', this.onQty);
          document.addEventListener('input', this.onQty);

          const anchor = document.querySelector('.sp-pdp__add');
          if (!anchor) return;
          this.hidden = false;
          this.setAttribute('inert', '');
          this.observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              const show = !entry.isIntersecting && entry.boundingClientRect.top < 0;
              this.classList.toggle('is-in', show);
              this.toggleAttribute('inert', !show);
            });
          }, { threshold: 0 });
          this.observer.observe(anchor);
        }
        disconnectedCallback() {
          document.removeEventListener('sprout:variant-change', this.onVariant);
          document.removeEventListener('change', this.onQty);
          document.removeEventListener('input', this.onQty);
          if (this.observer) this.observer.disconnect();
        }
      });
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .sp-sticky { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; display: block; background: var(--sp-sticky-bg, #fdfaf2); border-top: 1px solid var(--sp-line, #e3dccd); box-shadow: 0 -8px 24px rgb(39 55 43 / 0.1); transform: translateY(100%); transition: transform 0.3s var(--sp-ease); }
  .sp-sticky.is-in { transform: translateY(0); }
  .sp-sticky__bar { display: flex; align-items: center; gap: 14px; padding-block: 10px; }

  .sp-sticky__thumb { position: relative; flex: 0 0 auto; display: grid; place-items: center; width: 52px; height: 52px; border-radius: 16px; background: var(--sp-mint, #d8edcd); overflow: hidden; color: var(--sp-moss, #2f7a46); }
  .sp-sticky__thumb img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  .sp-sticky__copy { flex: 1 1 auto; min-width: 0; display: grid; }
  .sp-sticky__copy strong { font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sp-sticky__copy span { font-size: 13px; color: var(--sp-muted, #566358); }
  .sp-sticky__price { flex: 0 0 auto; font-weight: 700; font-size: 17px; }
  .sp-sticky__form { flex: 0 0 auto; margin: 0; }

  @media (max-width: 749px) { .sp-sticky__price { display: none; } }
  @media (prefers-reduced-motion: reduce) { .sp-sticky { transition: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Sticky buy bar",
  "tag": "div",
  "class": "sp-sticky-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "button_text", "label": "Button", "default": "Add to bag" },
    { "type": "color", "id": "background", "label": "Background", "default": "#fdfaf2" }
  ]
}
{% endschema %}
