{% comment %}
  Sprout base: brand tokens, layout primitives, buttons and the motion
  system. Rendered once from the layout, before any sp- section.

  @example
  {% render 'sp-base' %}
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600&family=Nunito:wght@400;500;600;700&display=swap">

<style>
  :root {
    /* Brand faces, loaded above. Horizon's own tokens are repointed at them
       so stock sections inherit the brand without being rewritten. */
    --font-heading--family: 'Fredoka', system-ui, sans-serif;
    --font-heading--weight: 500;
    --font-body--family: 'Nunito', system-ui, sans-serif;
    --font-subheading--family: 'Nunito', system-ui, sans-serif;
    --font-accent--family: 'Fredoka', system-ui, sans-serif;

    /* ground + surfaces */
    --sp-cream: #fdfaf2;
    --sp-mint: #d8edcd;
    --sp-sand: #fbe9d2;
    --sp-leaf: #6cb359;
    --sp-moss: #2f7a46;
    --sp-peach: #ffb784;
    --sp-sun: #ffd54a;
    --sp-coral: #ff8a6b;
    --sp-sky: #bfe3ef;
    --sp-ink: #27372b;
    --sp-ink-rgb: 39 55 43;
    --sp-muted: #566358;
    --sp-line: #e3dccd;
    --sp-line-mint: #d6e2d0;

    /* type */
    --sp-font-head: var(--font-heading--family, 'Fredoka', system-ui, sans-serif);
    --sp-font-body: var(--font-body--family, 'Nunito', system-ui, sans-serif);

    /* shape — everything round */
    --sp-r-btn: 999px;
    --sp-r-tile: 22px;
    --sp-r-card: 28px;
    --sp-r-band: 36px;
    --sp-r-hero: 44px;

    /* rhythm */
    --sp-page: 1180px;
    --sp-gutter: 24px;
    --sp-sec: clamp(40px, 5vw, 72px);
    --sp-ease: cubic-bezier(0.2, 0.7, 0.2, 1);
    --sp-ease-back: cubic-bezier(0.2, 0.7, 0.2, 1.6);
  }

  /* The cream ground, independent of the theme settings file. */
  body { background-color: var(--sp-cream); color: var(--sp-ink); }

  .sp-visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* ---- layout ---- */
  .sp-sec { padding-block: var(--sp-sec); background: var(--sp-sec-bg, transparent); color: var(--sp-sec-fg, inherit); }
  .sp-wrap { width: min(var(--sp-page), calc(100% - var(--sp-gutter) * 2)); margin-inline: auto; }
  .sp-wrap--wide { width: min(1240px, calc(100% - var(--sp-gutter) * 2)); }
  .sp-grid { display: grid; gap: 22px; }
  .sp-grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .sp-grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .sp-grid--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }

  /* ---- type ---- */
  /* Zero-specificity defaults: sections set their own spacing on the same
     element (class="sp-h2 sp-feat__title"), and a plain .sp-h2 rule would
     win on source order and silently flatten it. */
  :where(.sp-h1, .sp-h2, .sp-h3, .sp-lede) { margin: 0; }
  :where(.sp-eyebrow) { margin: 0 0 6px; }
  .sp-eyebrow { font-family: var(--sp-font-body); font-size: 13px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--sp-muted); }
  .sp-h1 { font-family: var(--sp-font-head); font-size: var(--sp-h1-size, clamp(42px, 5.4vw, 74px)); font-weight: 500; line-height: 1.02; letter-spacing: -0.025em; }
  .sp-h2 { font-family: var(--sp-font-head); font-size: var(--sp-h2-size, clamp(30px, 3.4vw, 48px)); font-weight: 500; line-height: 1.06; letter-spacing: -0.018em; }
  .sp-h3 { font-family: var(--sp-font-head); font-size: 24px; font-weight: 500; letter-spacing: -0.015em; }
  .sp-lede { font-size: clamp(16px, 1.3vw, 19px); line-height: 1.55; color: var(--sp-muted); }

  /* ---- buttons ---- */
  .sp-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 54px; padding: 0 28px; border: 0; border-radius: var(--sp-r-btn); font-family: var(--sp-font-body); font-size: 16px; font-weight: 700; text-decoration: none; cursor: pointer; transition: transform 0.22s var(--sp-ease-back), background-color 0.2s ease; }
  .sp-btn:hover { transform: translateY(-2px) scale(1.03); }
  .sp-btn:active { transform: translateY(0) scale(0.98); }
  .sp-btn--primary { background: var(--sp-moss); color: var(--sp-cream); }
  .sp-btn--soft { background: var(--sp-cream); color: var(--sp-moss); border: 2px solid var(--sp-line-mint); }
  .sp-btn--accent { background: var(--sp-peach); color: var(--sp-ink); }
  .sp-btn--dark { background: var(--sp-ink); color: var(--sp-cream); }
  .sp-btn--sm { min-height: 44px; padding: 0 18px; font-size: 14px; }
  .sp-btn:focus-visible { outline: 3px solid var(--sp-moss); outline-offset: 3px; }

  .sp-pill { display: inline-flex; align-items: center; gap: 8px; padding: 7px 14px; border-radius: 999px; background: var(--sp-mint); font-size: 13px; font-weight: 700; }
  .sp-pill--accent { background: var(--sp-peach); }

  /* ---- icon button / wishlist ---- */
  .sp-icon-btn { display: grid; place-items: center; width: 44px; height: 44px; border: 0; border-radius: 999px; background: transparent; color: inherit; cursor: pointer; }
  .sp-icon-btn:hover { background: rgb(var(--sp-ink-rgb) / 0.07); }

  /* ---- motion ---- */
  @keyframes sp-rise { from { opacity: 0; translate: 0 24px; } to { opacity: 1; translate: 0 0; } }
  @keyframes sp-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-7px); } }
  @keyframes sp-float { 0%, 100% { transform: translateY(0) rotate(var(--sp-r, 0deg)); } 50% { transform: translateY(-18px) rotate(var(--sp-r, 0deg)); } }
  @keyframes sp-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @keyframes sp-pop { 0% { transform: scale(1); } 45% { transform: scale(1.3); } 100% { transform: scale(1); } }
  @keyframes sp-wiggle { 0%, 100% { transform: rotate(0deg); } 25% { transform: rotate(-6deg); } 75% { transform: rotate(6deg); } }

  .sp-bob { animation: sp-bob 4.6s ease-in-out infinite; }
  .sp-bob--b { animation-duration: 5.8s; animation-delay: -1.5s; }
  .sp-bob--c { animation-duration: 6.6s; animation-delay: -3s; }
  .sp-wiggle { animation: sp-wiggle 2.6s ease-in-out infinite; }
  .sp-float { animation: sp-float 7s ease-in-out infinite; }
  .sp-float--b { animation-duration: 9s; animation-delay: -2s; }
  .sp-float--c { animation-duration: 11s; animation-delay: -4s; }
  .sp-heart:hover svg { animation: sp-pop 0.45s ease; }

  /* Entrance: hidden until the observer marks it in view, so it plays in
     every browser, not only the ones with scroll-driven animations. */
  .sp-reveal { opacity: 0; translate: 0 26px; }
  .sp-reveal.is-in { animation: sp-rise 0.7s var(--sp-ease) both; }
  .sp-reveal.is-in > * { animation: sp-rise 0.7s var(--sp-ease) both; }
  html.no-js .sp-reveal, .sp-reveal.is-in { opacity: 1; translate: none; }

  /* a little stagger for children of a revealed row */
  .sp-reveal.is-in > *:nth-child(2) { animation-delay: 0.08s; }
  .sp-reveal.is-in > *:nth-child(3) { animation-delay: 0.16s; }
  .sp-reveal.is-in > *:nth-child(4) { animation-delay: 0.24s; }
  .sp-reveal.is-in > *:nth-child(5) { animation-delay: 0.32s; }

  @keyframes sp-wag { 0%, 100% { transform: rotate(-9deg); } 50% { transform: rotate(9deg); } }
  .sp-wag { transform-origin: bottom left; animation: sp-wag 1.6s ease-in-out infinite; }
  @keyframes sp-blob { 0%, 100% { border-radius: 48% 52% 44% 56% / 52% 44% 56% 48%; }
                       50% { border-radius: 56% 44% 52% 48% / 44% 56% 48% 52%; } }
  .sp-blob { animation: sp-blob 12s ease-in-out infinite; }

  @media (prefers-reduced-motion: reduce) {
    .sp-bob, .sp-float, .sp-heart:hover svg, .sp-wag, .sp-blob, .sp-wiggle { animation: none; }
    .sp-reveal, .sp-reveal.is-in, .sp-reveal.is-in > * { animation: none; opacity: 1; translate: none; }
    .sp-btn { transition: none; }
  }

  /* ---- responsive ---- */
  @media (max-width: 989px) {
    .sp-grid--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sp-grid--3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 749px) {
    :root { --sp-gutter: 16px; }
    .sp-grid--2, .sp-grid--3, .sp-grid--4 { grid-template-columns: minmax(0, 1fr); }
  }
  /* colour bands so the page is not cream on cream */
  .sp-band--mint { background: var(--sp-mint); }
  .sp-band--sand { background: var(--sp-sand); }
  .sp-band--peach { background: var(--sp-peach); }
  .sp-band--moss { background: var(--sp-moss); color: var(--sp-cream); }
</style>

<script>
  /* A product that has no photo falls back to a theme asset named after its
     handle. When that asset is not there, the image removes itself and the
     illustration behind it stands in. */
  document.addEventListener('error', function (e) {
    var t = e.target;
    if (t && t.tagName === 'IMG' && t.hasAttribute('data-sp-fallback')) t.remove();
  }, true);
</script>

<script>
  (() => {
    const start = () => {
      const items = document.querySelectorAll('.sp-reveal');
      if (!('IntersectionObserver' in window)) {
        items.forEach((n) => n.classList.add('is-in'));
        return;
      }
      /* Horizon scrolls .page-wrapper rather than the document, so the
         observer has to watch that element — with the viewport as root it
         only reports the state at the moment it starts and never follows
         the scroll, leaving everything below the fold invisible. */
      const scroller = document.querySelector('.page-wrapper');
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        });
      }, { root: scroller || null, rootMargin: '0px 0px -8% 0px' });
      items.forEach((n) => io.observe(n));

      /* Belt and braces: reveal anything that has reached the viewport as the
         page scrolls, whichever element is doing the scrolling. */
      const sweep = function () {
        let left = false;
        items.forEach(function (n) {
          if (n.classList.contains('is-in')) return;
          if (n.getBoundingClientRect().top < window.innerHeight) n.classList.add('is-in');
          else left = true;
        });
        if (!left) {
          (scroller || window).removeEventListener('scroll', onScroll);
          window.removeEventListener('resize', onScroll);
        }
      };
      let ticking = false;
      const onScroll = function () {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function () { ticking = false; sweep(); });
      };
      (scroller || window).addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      sweep();

      /* Nothing may stay invisible. If neither path has reached an item a few
         seconds in, show it anyway — a missing animation beats a blank page. */
      setTimeout(function () {
        items.forEach(function (n) { n.classList.add('is-in'); });
      }, 4000);

    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
    else start();
    document.addEventListener('shopify:section:load', start);
  })();
</script>

{%- render 'sp-wishlist' -%}
