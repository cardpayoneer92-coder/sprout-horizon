{% comment %}
  Sprout icon set. Pass a name and an optional size.
  Names: check, leaf, shield, paw, heart, truck, search, user, bag, chevron,
  plus, arrow, star, bowl, clock, refresh.

  @example
  {% render 'sp-icon', name: 'paw', size: 20 %}
{% endcomment %}

{%- liquid
  assign sz = size | default: 20
  assign sw = stroke_width | default: 2
-%}
<svg class="sp-icon sp-icon--{{ name }}" width="{{ sz }}" height="{{ sz }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ sw }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'check' -%}
      <path d="m5 12.5 4.5 4.5L19 7.5"/>
    {%- when 'leaf' -%}
      <path d="M12 21v-9"/><path d="M12 13c0-4.5 3.5-8 8-8 0 4.5-3.5 8-8 8Z" fill="currentColor" stroke="none"/><path d="M11 17c0-3.4-3.4-6-7.5-6 0 3.4 3.4 6 7.5 6Z" fill="currentColor" stroke="none" opacity=".55"/>
    {%- when 'shield' -%}
      <path d="M12 3.5 19 6.3v5.4c0 4-3 7-7 8.8-4-1.8-7-4.8-7-8.8V6.3Z"/><path d="m9.2 12 2 2 3.6-3.9"/>
    {%- when 'paw' -%}
      <circle cx="12" cy="16" r="5" fill="currentColor" stroke="none"/><circle cx="6" cy="9.5" r="2.4" fill="currentColor" stroke="none"/><circle cx="11" cy="6.6" r="2.4" fill="currentColor" stroke="none"/><circle cx="17" cy="9" r="2.4" fill="currentColor" stroke="none"/>
    {%- when 'heart' -%}
      <path d="M12 20s-7-4.5-7-9a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 4.5-7 9-7 9Z"/>
    {%- when 'truck' -%}
      <path d="M3 7h10v9H3Z"/><path d="M13 10h4l3 3v3h-7Z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7"/><path d="m20 20-3.2-3.2"/>
    {%- when 'user' -%}
      <circle cx="12" cy="8" r="4"/><path d="M5 20c1.4-3.6 4-5.4 7-5.4s5.6 1.8 7 5.4"/>
    {%- when 'bag' -%}
      <path d="M6 8h12l-1 12H7L6 8Z"/><path d="M9 8a3 3 0 0 1 6 0"/>
    {%- when 'chevron' -%}
      <path d="m6 9 6 6 6-6"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'arrow' -%}
      <path d="M5 12h13"/><path d="m12 6 6 6-6 6"/>
    {%- when 'star' -%}
      <path d="m12 4 2.3 5 5.7.6-4.3 3.8 1.3 5.6L12 16l-5 3 1.3-5.6L4 9.6 9.7 9Z"/>
    {%- when 'bowl' -%}
      <path d="M4 11h16c0 5-3.6 8-8 8s-8-3-8-8Z"/><path d="M4 11c0-1.6 3.6-3 8-3s8 1.4 8 3"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="8"/><path d="M12 7.5V12l3 2"/>
    {%- when 'refresh' -%}
      <path d="M4 12a8 8 0 0 1 13.7-5.6"/><path d="M18 4v3.4h-3.4"/><path d="M20 12a8 8 0 0 1-13.7 5.6"/><path d="M6 20v-3.4h3.4"/>
    {%- else -%}
      <circle cx="12" cy="12" r="8"/>
  {%- endcase -%}
</svg>
