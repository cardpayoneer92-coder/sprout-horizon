{% comment %}
  Illustrated artwork, used wherever a photo has not been added yet so the
  page is never a grey box. Pass a name and an optional size. Pass a label only when the drawing
  means something on its own; without one it is hidden from screen readers.
  Names: duo, dog, puppy, cat, bunny, pouch, tin, jar, bowl, bed, bone, blanket.

  @example
  {% render 'sp-art', name: 'duo', size: 340 %}
{% endcomment %}

{%- liquid
  assign sz = size | default: 200
-%}
<svg class="sp-art sp-art--{{ name }}" width="{{ sz }}" height="{{ sz }}" viewBox="0 0 200 200" {% if label != blank %}role="img" aria-label="{{ label | escape }}"{% else %}aria-hidden="true"{% endif %} focusable="false">
  {%- case name -%}

    {%- when 'duo' -%}
      <ellipse cx="100" cy="170" rx="76" ry="18" fill="#2f7a46" opacity=".10"/>
      <circle cx="72" cy="100" r="42" fill="#fdfaf2"/>
