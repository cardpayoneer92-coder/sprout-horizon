      <path d="M28 62h144v26H28Z" fill="#ffb784"/>
      <path d="M52 108h96M52 128h66" stroke="#efe6d6" stroke-width="8" stroke-linecap="round"/>

    {%- else -%}
      <circle cx="100" cy="100" r="60" fill="#d8edcd"/>
      <circle cx="84" cy="92" r="7" fill="#27372b"/><circle cx="116" cy="92" r="7" fill="#27372b"/>
      <path d="M80 120c6 8 34 8 40 0" stroke="#27372b" stroke-width="5" stroke-linecap="round" fill="none"/>
