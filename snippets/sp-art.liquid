      <path d="M110 70c8-16 4-28-6-30-9-2-18 8-20 20Z" fill="#d08b4f"/>
      <circle cx="58" cy="96" r="5.4" fill="#27372b"/><circle cx="86" cy="96" r="5.4" fill="#27372b"/>
      <circle cx="60" cy="94" r="1.8" fill="#fff"/><circle cx="88" cy="94" r="1.8" fill="#fff"/>
      <ellipse cx="72" cy="113" rx="9" ry="7" fill="#27372b"/>
      <path d="M72 120v5M72 125q-6 7-11 1M72 125q6 7 11 1" stroke="#27372b" stroke-width="3" stroke-linecap="round" fill="none"/>
      <circle cx="46" cy="108" r="7" fill="#ff8a6b" opacity=".35"/>
      <circle cx="98" cy="108" r="7" fill="#ff8a6b" opacity=".35"/>
      <circle cx="142" cy="118" r="31" fill="#fbe9d2"/>
      <path d="M120 100l-3-18 16 9Z" fill="#a08b74"/><path d="M164 100l3-18-16 9Z" fill="#a08b74"/>
      <circle cx="132" cy="116" r="4" fill="#27372b"/><circle cx="152" cy="116" r="4" fill="#27372b"/>
      <path d="M142 123v3.5M142 126.5q-4.5 5.5-8 .8M142 126.5q4.5 5.5 8 .8" stroke="#27372b" stroke-width="2.3" stroke-linecap="round" fill="none"/>
      <path class="sp-wag" d="M172 132c14-6 22 2 20 10-2 7-12 9-20 4" fill="#6cb359"/>

    {%- when 'dog' -%}
      <ellipse cx="100" cy="168" rx="58" ry="15" fill="#2f7a46" opacity=".10"/>
      <circle cx="100" cy="98" r="48" fill="#fdfaf2"/>
      <path d="M56 64c-9-18-4-31 7-33 10-2 20 9 22 22Z" fill="#d08b4f"/>
      <path d="M144 64c9-18 4-31-7-33-10-2-20 9-22 22Z" fill="#d08b4f"/>
