{% comment %}
  Product card: 4:5 photo, a size hint read from the pet profile, a heart,
  a quick-add that posts to the cart, the title and the price.

  @example
  {% render 'sp-product-card', product: product, show_quick_add: true %}
{% endcomment %}

{%- liquid
  assign p = product
  assign quick = show_quick_add | default: true, allow_false: true
  assign tint = index | default: 0 | modulo: 2
-%}

{%- if p == blank or p == empty -%}
  {%- liquid
    assign demo_art = 'pouch,jar,bed,bowl,tin,bone' | split: ','
    assign demo_names = 'Chicken &amp; pumpkin dinner,Carrot crunch treats,Cloud bed,Slow bowl,Salmon pâté,Rope bone' | split: ','
    assign pick = index | default: 0 | modulo: 6
  -%}
  <article class="sp-card sp-card--empty">
    <div class="sp-card__media sp-card__media--{{ tint }}">
      <span class="sp-card__art sp-bob">{% render 'sp-art', name: demo_art[pick], size: 170 %}</span>
    </div>
    <h3 class="sp-card__title">{{ demo_names[pick] }}</h3>
    <span class="sp-card__price">[PRICE]</span>
  </article>
{%- else -%}
  {%- assign sp_pet_tags = p.tags | join: ',' | downcase -%}
  <article class="sp-card" data-pet-tags="{{ sp_pet_tags }}">
    <div class="sp-card__media sp-card__media--{{ tint }}">
      <a class="sp-card__link" href="{{ p.url }}" aria-label="{{ p.title | escape }}">
        {%- if p.featured_media -%}
          <img
            class="sp-card__img sp-card__img--main"
            src="{{ p.featured_media | image_url: width: 800 }}"
            srcset="{{ p.featured_media | image_url: width: 400 }} 400w, {{ p.featured_media | image_url: width: 800 }} 800w"
            sizes="(min-width: 990px) 280px, 46vw"
            alt="{{ p.featured_media.alt | default: p.title | escape }}"
            width="{{ p.featured_media.width }}"
            height="{{ p.featured_media.height }}"
            loading="lazy"
          >
          {%- if p.media[1] -%}
            <img
              class="sp-card__img sp-card__img--alt"
              src="{{ p.media[1] | image_url: width: 800 }}"
              alt=""
              width="{{ p.media[1].width }}"
              height="{{ p.media[1].height }}"
              loading="lazy"
              aria-hidden="true"
            >
          {%- endif -%}
        {%- else -%}
          <span class="sp-card__art sp-bob">{% render 'sp-art', name: 'pouch', size: 170, label: p.title %}</span>
          {%- assign shot = 'sp-' | append: p.handle | append: '-1.png' -%}
          {%- assign shot_alt = 'sp-' | append: p.handle | append: '-2.png' -%}
          <img class="sp-card__img sp-card__img--main" data-sp-fallback src="{{ shot | asset_url }}" alt="{{ p.title | escape }}" loading="lazy">
          <img class="sp-card__img sp-card__img--alt" data-sp-fallback src="{{ shot_alt | asset_url }}" alt="" loading="lazy" aria-hidden="true">
        {%- endif -%}
      </a>

      {%- if p.available == false -%}
        <span class="sp-card__flag">Sold out</span>
      {%- elsif p.tags contains 'new' -%}
        <span class="sp-card__flag">New</span>
      {%- else -%}
        <span class="sp-card__flag sp-card__flag--fit" data-fit hidden></span>
      {%- endif -%}

      <button type="button" class="sp-card__heart sp-heart" data-wish-handle="{{ p.handle }}" aria-pressed="false" aria-label="Save {{ p.title | escape }} to wishlist">
        {% render 'sp-icon', name: 'heart', size: 18 %}
      </button>

      {%- if quick and p.available -%}
        {%- form 'product', p, class: 'sp-card__quick', id: null -%}
          <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
          <button type="submit" class="sp-btn sp-btn--dark sp-btn--sm sp-card__quick-btn">Quick add</button>
        {%- endform -%}
      {%- endif -%}
    </div>

    <h3 class="sp-card__title"><a href="{{ p.url }}">{{ p.title }}</a></h3>
    {%- if p.type != blank -%}<p class="sp-card__meta">{{ p.type }}</p>{%- endif -%}
    <span class="sp-card__price">
      {%- if p.compare_at_price > p.price -%}
        <s>{{ p.compare_at_price | money }}</s>
      {%- endif -%}
      {{ p.price | money }}
    </span>
  </article>
{%- endif -%}
